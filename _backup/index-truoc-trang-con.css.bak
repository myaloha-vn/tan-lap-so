@import url('https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:ital,wght@0,400;0,500;0,600;0,700;0,800;0,900;1,700&family=Dancing+Script:wght@600;700&family=Great+Vibes&display=swap');
@import 'tailwindcss';

:root {
  --blue: #0868c9;
  --blue-dark: #064a91;
  --navy: #073561;
  --orange: #f46b24;
  --ink: #123451;
  --muted: #64798b;
  --sky: #eef8ff;
  --line: #dde9f1;
  --white: #fff;
  --shadow: 0 15px 40px rgba(25, 76, 113, .1);
}

* { box-sizing: border-box; }
html { scroll-behavior: smooth; }
body { margin: 0; font-family: 'Be Vietnam Pro', sans-serif; color: var(--ink); background: #e0eefd; }
button, input { font: inherit; }
button, a { -webkit-tap-highlight-color: transparent; }
a { color: inherit; text-decoration: none; }
img { display: block; width: 100%; }
.container { width: min(1320px, calc(100% - 64px)); margin: 0 auto; }

.header { position: fixed; z-index: 50; top: 0; left: 0; right: 0; height: 80px; background: rgba(255,255,255,.96); border-bottom: 1px solid rgba(215,229,239,.8); box-shadow: 0 5px 25px rgba(15,64,100,.06); backdrop-filter: blur(14px); }
.header__inner { height: 100%; display: flex; align-items: center; justify-content: space-between; gap: 22px; }
.logo { display: flex; align-items: center; gap: 10px; min-width: 160px; color: var(--blue-dark); }
.logo__mark { width: 42px; height: 42px; position: relative; background: linear-gradient(145deg, var(--blue), #13a3dd); border-radius: 14px 14px 14px 5px; overflow: hidden; box-shadow: 0 6px 15px rgba(8,104,201,.25); }
.logo__mark:after { content:""; position: absolute; width: 27px; height: 18px; background: white; border-radius: 60% 60% 0 0; bottom: -9px; left: 8px; }
.logo__mark span { position: absolute; bottom: 9px; width: 4px; border-radius: 4px; background: #ff9a48; z-index: 1; }
.logo__mark span:nth-child(1){height:11px;left:12px}.logo__mark span:nth-child(2){height:17px;left:19px}.logo__mark span:nth-child(3){height:23px;left:26px}
.logo strong { display: block; font-size: 18px; letter-spacing: .4px; line-height: 1.05; }
.logo small { display: block; font-size: 8px; font-weight: 700; color: var(--orange); letter-spacing: 1.4px; margin-top: 4px; }
.nav { display: flex; align-items: center; gap: clamp(15px, 1.4vw, 25px); height: 100%; }
.nav a { display: grid; place-items: center; height: 100%; font-size: 13px; font-weight: 600; white-space: nowrap; color: #34556f; position: relative; transition: color .2s; }
.nav a:after { content:""; position:absolute; bottom:0; height:3px; left:50%; right:50%; background:var(--orange); border-radius:3px 3px 0 0; transition:all .25s; }
.nav a:hover,.nav a.active { color: var(--blue); }
.nav a:hover:after,.nav a.active:after { left:3px; right:3px; }
.header__actions { display: flex; gap: 8px; align-items:center; }
.icon-button,.menu-button { border: 0; background: #f1f7fb; color: var(--blue-dark); width: 40px; height:40px; border-radius: 12px; display:grid; place-items:center; cursor:pointer; }
.login-button { border:0; background:var(--blue); color:white; height:40px; padding:0 16px; border-radius:12px; display:flex; align-items:center; gap:7px; font-size:12px; font-weight:600; cursor:pointer; box-shadow:0 6px 14px rgba(8,104,201,.2); }
.menu-button { display:none; }

/* Ảnh nền cố định toàn trang (kiểu Xuân Hòa Số): ảnh đứng yên, các khối trong suốt cuộn qua bên trên */
.page-bg { position: fixed; inset: 0; z-index: -2; background-size: cover; background-position: center 35%; background-repeat: no-repeat; opacity: .55; pointer-events: none; }
.page-bg::after { content: ""; position: absolute; inset: 0; background: rgba(240,247,255,.38); }
.section-heading h2, .section-heading .eyebrow, .view-all, .welcome, .hero__content>p { text-shadow: 0 0 18px rgba(255,255,255,.95), 0 0 6px rgba(255,255,255,.9); }
.hero { height: 700px; margin-top:0; background: transparent; overflow:hidden; }
.hero__inner { height:100%; display:grid; grid-template-columns: 46% 54%; align-items:center; gap:54px; }
.welcome { font-family:'Dancing Script', cursive; color:var(--orange); font-size:31px; font-weight:700; display:block; margin-bottom:4px; transform:rotate(-2deg); transform-origin:left; }
.hero h1 { margin:0; font-size:clamp(53px,5.1vw,76px); line-height:1; letter-spacing:-3px; color:var(--blue); font-weight:800; text-shadow:0 2px 0 white; }
.hero h1 em { color:var(--orange); font-style:normal; position:relative; }
.hero h1 em:after { content:""; position:absolute; height:5px; left:3px; right:0; bottom:-5px; border-radius:50%; background:var(--orange); transform:rotate(-3deg); opacity:.7; }
.hero__content>p { max-width:590px; margin:26px 0 26px; color:#2f4a5e; font-weight:500; line-height:1.8; font-size:15px; }
.hero-search { max-width:570px; height:58px; display:flex; align-items:center; gap:12px; padding:6px 7px 6px 18px; background:white; border:1px solid rgba(197,219,234,.8); border-radius:15px; box-shadow:0 13px 30px rgba(32,85,123,.12); color:#7c91a1; }
.hero-search input { min-width:0; flex:1; border:0; outline:0; font-size:13px; color:var(--ink); }
.hero-search input::placeholder{color:#97a8b5}
.hero-search button { height:44px; padding:0 19px; border:0; border-radius:11px; background:var(--orange); color:white; font-weight:600; font-size:12px; cursor:pointer; }
.hero-shortcuts { display:grid; grid-template-columns:repeat(4,1fr); gap:9px; max-width:570px; margin-top:16px; }
.hero-shortcuts a { height:51px; background:rgba(255,255,255,.82); border:1px solid white; border-radius:13px; display:flex; align-items:center; justify-content:center; gap:7px; color:#31566f; font-size:11px; font-weight:600; box-shadow:0 6px 18px rgba(32,85,123,.06); transition:.25s; }
.hero-shortcuts a span { color:var(--blue); }
.hero-shortcuts a:hover { transform:translateY(-3px); background:white; color:var(--blue); }
.hero__map { min-width:0; }
.map-card { background:white; padding:12px; border-radius:23px; box-shadow:0 25px 60px rgba(14,59,91,.22); border:1px solid rgba(255,255,255,.9); transform:rotate(.4deg); }
.map-card__head { height:62px; display:flex; align-items:center; justify-content:space-between; padding:0 9px 0 13px; }
.map-card__head div { display:flex; flex-direction:column; }
.map-card__head span { color:var(--orange); font-size:9px; font-weight:800; letter-spacing:1.5px; }
.map-card__head strong { font-size:19px; color:var(--navy); margin-top:2px; }
.map-card__head button { border:1px solid var(--line); background:#f7fbfe; border-radius:9px; width:36px; height:36px; display:grid; place-items:center; color:var(--blue); }
.map-canvas { height:365px; border-radius:16px; overflow:hidden; background-color:#eef2e9; background-image:linear-gradient(30deg,rgba(255,255,255,.45) 12%,transparent 12.5%,transparent 87%,rgba(255,255,255,.45) 87.5%),linear-gradient(150deg,rgba(255,255,255,.4) 12%,transparent 12.5%,transparent 87%,rgba(255,255,255,.4) 87.5%); background-size:50px 85px; position:relative; }
.map-labels { font-size:9px; font-weight:800; fill:#22455c; letter-spacing:.4px; }
.map-zoom { position:absolute; top:12px; right:12px; display:flex; flex-direction:column; background:white; border-radius:8px; overflow:hidden; box-shadow:0 5px 16px rgba(24,64,89,.16); }
.map-zoom button { width:31px;height:30px;border:0;background:white;color:#31546c;font-size:20px;border-bottom:1px solid #edf1f4;cursor:pointer; }
.map-legend { position:absolute; bottom:12px; left:12px; display:flex; flex-direction:column; gap:4px; background:rgba(255,255,255,.94); border-radius:9px; padding:9px 12px; box-shadow:0 4px 13px rgba(33,73,98,.13); font-size:8px; color:#526b7e; }
.map-legend strong { color:var(--ink);font-size:9px;margin-bottom:1px}.map-legend span{display:flex;align-items:center;gap:5px}.dot{width:6px;height:6px;border-radius:50%}.dot--orange{background:var(--orange)}.dot--blue{background:#65b5ff}
.map-card__footer { min-height:48px; display:flex; justify-content:space-between; align-items:center; padding:5px 8px 0 12px; }
.map-card__footer span { display:flex;align-items:center;gap:5px;font-size:8px;color:#8aa0b0}.map-card__footer button{border:0;background:none;color:var(--blue);font-size:10px;font-weight:700;display:flex;align-items:center;gap:5px;cursor:pointer}

.section,.stats-section { padding:88px 0; }
.stats-section { padding-bottom:65px; background:transparent; }
.section-heading { display:flex; align-items:flex-end; justify-content:space-between; gap:30px; margin-bottom:35px; }
.eyebrow { color:var(--orange); font-size:12px; font-weight:800; letter-spacing:2.2px; display:flex; align-items:center; gap:9px; margin-bottom:10px; }
.eyebrow:before { content:"";width:26px;height:3px;background:var(--orange);border-radius:3px; }
.section-heading h2 { margin:0;color:var(--navy);font-size:40px;line-height:1.2;letter-spacing:-1.2px; }
.view-all { display:flex;align-items:center;gap:8px;color:var(--blue);font-size:14px;font-weight:700;padding-bottom:5px;transition:gap .2s}.view-all:hover{gap:13px}
.stats-grid { display:grid;grid-template-columns:repeat(9,1fr);border:1px solid var(--line);border-radius:18px;background:white;box-shadow:0 12px 35px rgba(29,80,116,.07);overflow:hidden; }
.stat-card { min-width:0; padding:26px 10px;display:flex;flex-direction:column;align-items:center;text-align:center;border-right:1px solid var(--line);transition:.25s; }
.stat-card:last-child{border:0}.stat-card:hover{background:#f7fbff;transform:translateY(-3px)}
.stat-icon{width:50px;height:50px;border-radius:14px;display:grid;place-items:center;margin-bottom:15px;color:#0874d1;background:#e7f3ff}.stat-icon svg{width:26px;height:26px}.stat-icon--1{background:#fff1e9;color:var(--orange)}.stat-icon--2{background:#e9f8ef;color:#28a165}.stat-icon--3{background:#f1edff;color:#7358c9}
.stat-card strong{font-size:13px;line-height:1.45;color:var(--blue-dark);white-space:nowrap}.stat-card small{font-size:12px;color:#8295a4;margin-top:6px}

.utilities { background:transparent; }
.utility-grid { display:grid;grid-template-columns:repeat(7,1fr);gap:12px; }
.utility-card { position:relative;display:flex;flex-direction:column;align-items:center;text-align:center;padding:28px 14px 24px;background:rgba(255,255,255,.92);border:1px solid rgba(255,255,255,.9);border-radius:20px;box-shadow:0 10px 28px rgba(23,70,103,.12);backdrop-filter:blur(8px);color:var(--navy);transition:transform .3s,box-shadow .3s; }
.utility-card:hover{transform:translateY(-6px);box-shadow:0 18px 36px rgba(23,70,103,.2)}
.utility-card__icon { width:72px;height:72px;display:grid;place-items:center;border-radius:20px;margin-bottom:16px;transition:transform .3s; }
.utility-card:hover .utility-card__icon{transform:scale(1.08)}
.utility-card strong{font-size:16px;line-height:1.35;color:var(--navy)}
.utility-card small{font-size:12px;line-height:1.5;color:#6f8597;margin:6px 0 14px}
.utility-card__arrow{margin-top:auto;width:30px;height:30px;border-radius:50%;display:grid;place-items:center;background:#eef6ff;color:var(--blue);transition:.25s}
.utility-card:hover .utility-card__arrow{background:var(--blue);color:white}
.utility-card--c0 .utility-card__icon{background:#e7f2ff;color:#0b6fd0}
.utility-card--c1 .utility-card__icon{background:#fff0e6;color:#ef6a1f}
.utility-card--c2 .utility-card__icon{background:#e7f8ee;color:#22a15f}
.utility-card--c3 .utility-card__icon{background:#f0ebff;color:#7356d0}
.utility-card--c4 .utility-card__icon{background:#ffe9ef;color:#e0436b}
.utility-card--c5 .utility-card__icon{background:#e5f7fa;color:#0f97ad}
.utility-card--c6 .utility-card__icon{background:#fff6dc;color:#d99a00}

.explore { overflow:hidden; }
.places-grid { display:grid;grid-template-columns:repeat(5,1fr);gap:16px; }
.place-card { border:1px solid var(--line);border-radius:18px;background:white;overflow:hidden;box-shadow:0 8px 24px rgba(28,75,108,.07);transition:.28s}.place-card:hover{transform:translateY(-6px);box-shadow:var(--shadow)}
.place-card__image{height:210px;overflow:hidden;position:relative}.place-card__image img{height:100%;object-fit:cover;transition:transform .5s}.place-card:hover img{transform:scale(1.06)}.place-card__image span{position:absolute;top:12px;right:12px;width:34px;height:34px;border-radius:9px;background:rgba(255,255,255,.88);display:grid;place-items:center;font-size:11px;font-weight:800;color:var(--blue)}
.place-card__body{padding:22px 19px 24px}.place-card__body h3{font-size:17px;line-height:1.45;margin:0 0 10px;color:var(--navy)}.place-card__body p{font-size:13px;line-height:1.7;margin:0;color:#718697;min-height:66px}.place-card__body a{display:flex;align-items:center;gap:7px;margin-top:16px;color:var(--blue);font-size:13px;font-weight:700}

.news{background:transparent}.news-layout{display:grid;grid-template-columns:3fr 2fr;gap:23px}.featured-news{display:grid;grid-template-columns:54% 46%;background:white;border-radius:20px;overflow:hidden;box-shadow:var(--shadow)}.featured-news__image{position:relative;min-height:450px;overflow:hidden}.featured-news__image img{height:100%;object-fit:cover;transition:.5s}.featured-news:hover img{transform:scale(1.04)}.featured-news__image span{position:absolute;left:18px;top:18px;background:var(--orange);color:white;border-radius:7px;padding:9px 12px;font-size:10px;font-weight:800;letter-spacing:1px}.featured-news__body{padding:42px 34px;display:flex;flex-direction:column;justify-content:center}.date,.news-item span{display:flex;align-items:center;gap:6px;color:#8a9dab;font-size:11px}.featured-news h3{font-size:26px;line-height:1.5;color:var(--navy);margin:17px 0 14px}.featured-news p{font-size:14px;line-height:1.75;color:#6c8191;margin:0}.featured-news a{display:flex;align-items:center;gap:8px;color:var(--blue);font-weight:700;font-size:14px;margin-top:27px}
.news-list{display:grid;grid-template-rows:repeat(4,1fr);gap:10px}.news-item{display:grid;grid-template-columns:155px 1fr;gap:18px;padding:11px;background:white;border:1px solid #e7eff5;border-radius:15px;transition:.25s}.news-item:hover{transform:translateX(-4px);box-shadow:0 9px 23px rgba(27,74,107,.09)}.news-item img{height:100%;min-height:96px;object-fit:cover;border-radius:10px}.news-item>div{display:flex;flex-direction:column;justify-content:center}.news-item h3{font-size:13px;line-height:1.55;color:var(--navy);margin:7px 0}.news-item a{display:flex;align-items:center;color:var(--blue);font-size:11px;font-weight:600}

.support-strip{background:rgba(255,255,255,.82);backdrop-filter:blur(10px);padding:34px 0;border-top:1px solid rgba(255,255,255,.6)}.support-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:18px}.support-grid>a{display:flex;align-items:center;gap:13px;padding:9px 17px;border-right:1px solid var(--line)}.support-grid>a:last-child{border:0}.support-grid>a>span{width:50px;height:50px;border-radius:14px;display:grid;place-items:center;color:var(--blue);background:#eaf5ff}.support-grid>a:nth-child(2)>span{color:#7c55d6;background:#f2edff}.support-grid>a:nth-child(3)>span{color:#27a265;background:#e9f8ef}.support-grid>a:nth-child(4)>span{color:var(--orange);background:#fff0e8}.support-grid>a>div{display:flex;flex-direction:column;flex:1}.support-grid strong{font-size:15px;color:var(--navy)}.support-grid small{font-size:11px;color:#8a9ba8;margin-top:4px}.support-grid>a>svg{color:#a1b0bb;transition:.2s}.support-grid>a:hover>svg{transform:translateX(4px);color:var(--blue)}
.footer{background:#06355f;color:white;padding-top:65px;position:relative;overflow:hidden}.footer:after{content:"";position:absolute;width:450px;height:450px;border:100px solid rgba(255,255,255,.025);border-radius:50%;right:-120px;top:-160px}.footer__top{display:grid;grid-template-columns:1.6fr repeat(3,1fr);gap:70px;padding-bottom:52px;position:relative;z-index:1}.logo--light{color:white}.logo--light small{color:#ff9b57}.footer__brand>p{font-size:13px;color:#b1c5d7;line-height:1.8;max-width:310px;margin:21px 0}.footer__badge{display:inline-flex;align-items:center;gap:7px;border:1px solid rgba(255,255,255,.15);border-radius:9px;padding:9px 12px;font-size:11px;color:#bcd0df}.footer h4{font-size:15px;margin:3px 0 22px;color:white}.footer__top>div:not(:first-child){display:flex;flex-direction:column}.footer__top a{font-size:12px;color:#afc3d3;margin-bottom:15px;transition:.2s}.footer__top a:hover{color:white;transform:translateX(3px)}.footer__contact p{font-size:12px;color:#afc3d3;display:flex;align-items:center;gap:9px;margin:0 0 16px}.footer__bottom{height:65px;border-top:1px solid rgba(255,255,255,.1);display:flex;justify-content:space-between;align-items:center;color:#83a2ba;font-size:10px;position:relative;z-index:1}

@media (max-width: 1180px) {
  .container{width:min(100% - 40px,1120px)}.nav{gap:12px}.nav a{font-size:11px}.login-button span{display:none}.login-button{width:40px;padding:0;justify-content:center}
  .hero{height:auto;min-height:690px;padding:60px 0}.hero__inner{gap:28px;grid-template-columns:44% 56%}.map-canvas{height:330px}.stats-grid{grid-template-columns:repeat(5,1fr)}.stat-card:nth-child(5){border-right:0}.utility-grid{grid-template-columns:repeat(4,1fr)}.places-grid{grid-template-columns:repeat(3,1fr)}.news-layout{grid-template-columns:1fr}.featured-news{min-height:420px}.news-list{grid-template-columns:1fr 1fr;grid-template-rows:auto}.footer__top{gap:35px}
}

@media (max-width: 820px) {
  .container{width:calc(100% - 30px)}.header{height:70px}.header__inner{position:relative}.nav{position:fixed;top:70px;left:0;right:0;height:auto;padding:12px 20px 20px;display:none;flex-direction:column;align-items:stretch;background:white;box-shadow:0 15px 25px rgba(20,55,80,.12)}.nav--open{display:flex}.nav a{height:42px;justify-content:flex-start}.nav a:after{display:none}.menu-button{display:grid}.hero{margin-top:70px;background-attachment:scroll;padding:55px 0}.hero__inner{grid-template-columns:1fr}.hero__content{text-align:center}.welcome{font-size:27px;transform:none}.hero h1{font-size:53px}.hero__content>p,.hero-search,.hero-shortcuts{margin-left:auto;margin-right:auto}.hero__map{margin-top:12px}.map-card{transform:none}.map-canvas{height:370px}.section,.stats-section{padding:70px 0}.section-heading h2{font-size:32px}.stats-grid{grid-template-columns:repeat(3,1fr)}.stat-card:nth-child(5){border-right:1px solid var(--line)}.stat-card:nth-child(3n){border-right:0}.utility-grid{grid-template-columns:repeat(2,1fr)}.places-grid{grid-template-columns:repeat(2,1fr)}.featured-news{grid-template-columns:1fr}.featured-news__image{min-height:320px}.news-list{grid-template-columns:1fr}.support-grid{grid-template-columns:1fr 1fr}.support-grid>a:nth-child(2){border:0}.footer__top{grid-template-columns:1.3fr 1fr;gap:45px}.footer__brand{grid-column:1/-1}
}

@media (max-width: 520px) {
  .logo{min-width:auto}.logo strong{font-size:15px}.logo small{font-size:7px}.logo__mark{width:38px;height:38px}.header__actions .icon-button{display:none}
  .hero{padding-top:42px}.hero h1{font-size:43px;letter-spacing:-2px}.welcome{font-size:24px}.hero__content>p{font-size:13px;line-height:1.7}.hero-search{height:54px;padding-left:14px}.hero-search button{padding:0 13px}.hero-shortcuts{grid-template-columns:1fr 1fr}.hero-shortcuts a{height:47px}.map-card__head strong{font-size:16px}.map-canvas{height:285px}.map-legend{display:none}.map-card__footer span{display:none}.map-card__footer{justify-content:flex-end}
  .section-heading{align-items:flex-start}.section-heading h2{font-size:28px}.view-all{font-size:0}.view-all svg{width:24px;height:24px}.stats-grid{grid-template-columns:repeat(2,1fr)}.stat-card:nth-child(3n){border-right:1px solid var(--line)}.stat-card:nth-child(2n){border-right:0}.utility-grid{grid-template-columns:1fr 1fr;gap:10px}.utility-card{padding:22px 10px 18px}.utility-card__icon{width:60px;height:60px}.utility-card small{display:none}.places-grid{display:flex;overflow-x:auto;padding:0 2px 18px;scroll-snap-type:x mandatory}.place-card{min-width:82%;scroll-snap-align:start}.place-card__image{height:220px}.featured-news__body{padding:30px 23px}.featured-news h3{font-size:22px}.featured-news p{font-size:13px}.news-item{grid-template-columns:110px 1fr;gap:12px}.news-item h3{font-size:12px}.support-grid{grid-template-columns:1fr}.support-grid>a{border-right:0;border-bottom:1px solid var(--line)}.support-grid>a:nth-child(2){border-bottom:1px solid var(--line)}.footer__top{grid-template-columns:1fr 1fr;gap:35px 20px}.footer__contact{grid-column:1/-1}.footer__bottom{height:auto;min-height:70px;flex-direction:column;justify-content:center;gap:8px}.footer{padding-top:50px}
}

/* Thanh thông tin trên cùng (thay header) — theo mẫu Xuân Hòa Số */
.topbar-wrap { position: sticky; top: 0; z-index: 40; padding: 12px 16px 0; }
.topbar { max-width: 1300px; margin: 0 auto; display: flex; align-items: center; flex-wrap: wrap; gap: 8px 24px; padding: 10px 20px; background: rgba(255,255,255,.74); border: 1px solid rgba(37,84,176,.26); border-radius: 16px; box-shadow: 0 4px 32px rgba(19,41,77,.1); backdrop-filter: blur(10px); font-size: 13px; color: #374151; line-height: 1.3; }
.topbar__time { display: flex; align-items: center; gap: 8px; }
.topbar__time strong { color: #1e3a6e; font-weight: 700; }
.topbar__date { font-weight: 500; }
.topbar__sep { width: 1px; height: 16px; background: #99f6e4; }
.topbar__admin { margin-left: auto; color: #1e3a6e; font-weight: 600; white-space: nowrap; transition: color .2s; }
.topbar__admin:hover { color: var(--blue); }
.hero__logo { margin-bottom: 22px; }
@media (max-width: 820px) {
  .hero { margin-top: 0; }
  .topbar-wrap { padding: 10px 12px 0; }
  .topbar { padding: 9px 14px; gap: 6px 14px; font-size: 12px; }
  .topbar__time span, .topbar__date, .topbar__sep--date, .topbar__place, .topbar__sep--place { display: none; }
  .hero__logo { display: flex; justify-content: center; }
}

/* ===== Cân đối lại cỡ chữ, độ đậm màu chữ và khoảng cách giữa các section ===== */
/* Khoảng cách section: gọn lại */
.section, .stats-section { padding: 40px 0; }
.stats-section { padding-top: 24px; }
.hero { height: 640px; }
.section-heading { margin-bottom: 26px; }

/* Tiêu đề section */
.eyebrow { font-size: 14px; letter-spacing: 2px; }
.section-heading h2 { font-size: 44px; font-weight: 800; letter-spacing: -1px; }
.view-all { font-size: 16px; }

/* Hero */
.welcome { font-size: 36px; }
.hero__content>p { font-size: 18px; line-height: 1.75; color: #1d3a52; }
.hero-search { height: 62px; }
.hero-search input { font-size: 16px; }
.hero-search button { font-size: 15px; height: 48px; padding: 0 24px; }
.hero-shortcuts a { height: 56px; font-size: 14px; }

/* Thẻ bản đồ */
.map-card__head span { font-size: 11px; }
.map-card__head strong { font-size: 22px; }
.map-labels { font-size: 11px; }
.map-legend { font-size: 11px; padding: 10px 13px; }
.map-legend strong { font-size: 12px; }
.map-card__footer span { font-size: 12px; color: #5f7586; }
.map-card__footer button { font-size: 13px; }

/* Thanh thông tin */
.topbar { font-size: 15px; padding: 11px 22px; }

/* Tổng quan */
.stat-card strong { font-size: 16px; }
.stat-card small { font-size: 14px; color: #5d7385; }

/* Tiện ích nhanh */
.utility-card strong { font-size: 18px; }
.utility-card small { font-size: 14px; color: #53697b; }

/* Khám phá */
.place-card__body h3 { font-size: 19px; font-weight: 700; }
.place-card__body p { font-size: 15px; color: #4f6476; }
.place-card__body a { font-size: 15px; }

/* Tin tức */
.date, .news-item span { font-size: 13px; color: #5f7586; }
.featured-news h3 { font-size: 28px; }
.featured-news p { font-size: 16px; color: #4f6476; }
.featured-news a { font-size: 16px; }
.news-item h3 { font-size: 15px; }
.news-item a { font-size: 13px; }

/* Hỗ trợ + chân trang */
.support-strip { padding: 26px 0; }
.support-grid strong { font-size: 17px; }
.support-grid small { font-size: 13px; color: #5d7385; }
.footer { padding-top: 52px; }
.footer__brand>p { font-size: 15px; color: #c7d7e5; }
.footer h4 { font-size: 17px; }
.footer__top a, .footer__contact p { font-size: 14px; color: #c3d4e2; }
.footer__badge { font-size: 13px; }
.footer__bottom { font-size: 13px; color: #9fb7ca; }

@media (max-width: 1180px) {
  .hero { height: auto; min-height: 0; padding: 48px 0; }
  .section-heading h2 { font-size: 38px; }
}
@media (max-width: 820px) {
  .section, .stats-section { padding: 32px 0; }
  .stats-section { padding-top: 16px; }
  .hero { padding: 36px 0; }
  .topbar { font-size: 13px; padding: 9px 14px; }
}
@media (max-width: 520px) {
  .section-heading h2 { font-size: 30px; }
  .view-all { font-size: 0; }
  .eyebrow { font-size: 12px; }
  .welcome { font-size: 28px; }
  .hero__content>p { font-size: 15px; }
  .hero-shortcuts a { font-size: 13px; height: 50px; }
  .featured-news h3 { font-size: 22px; }
  .featured-news p { font-size: 15px; }
  .news-item h3 { font-size: 14px; }
}

/* ===== Tiêu đề hero theo mẫu: chữ viết tay xanh + TÂN LẬP xanh đậm + SỐ cam có tia nắng ===== */
.welcome { font-family: 'Great Vibes', 'Dancing Script', cursive; font-weight: 400; font-size: 60px; line-height: 1.1; white-space: nowrap; color: #1f55c9; transform: none; margin-bottom: 2px;
  text-shadow: none; filter: drop-shadow(0 0 1.5px #fff) drop-shadow(0 0 1.5px #fff) drop-shadow(0 0 1.5px #fff) drop-shadow(0 3px 8px rgba(20,60,140,.18)); }
.hero h1 { font-weight: 900; font-size: clamp(60px, 5.6vw, 92px); letter-spacing: -1px; line-height: 1; color: #1747b5; text-shadow: none;
  filter: drop-shadow(0 0 2px #fff) drop-shadow(0 0 2px #fff) drop-shadow(0 0 2px #fff) drop-shadow(0 6px 14px rgba(15,50,120,.22)); }
.hero h1 em { position: relative; display: inline-block; color: transparent; background: linear-gradient(180deg, #ffb52a 0%, #f7841c 55%, #ee6411 100%); -webkit-background-clip: text; background-clip: text; -webkit-text-stroke: 0; }
.hero h1 em:after { display: none; }
.sun-rays { position: absolute; width: .72em; height: .43em; left: 73%; top: -.33em; transform: translateX(-50%); overflow: visible; }
.hero__content>p { color: #18324a; }
@media (max-width: 820px) { .welcome { font-size: 48px; } .hero h1 { font-size: 58px; } }
@media (max-width: 520px) { .welcome { font-size: 40px; } .hero h1 { font-size: 46px; } }

/* Giãn dòng tiêu đề hero, không cắt dấu chữ SỐ */
.welcome { line-height: 1.25; margin-bottom: 6px; padding-top: 4px; }
.hero h1 { line-height: 1.18; padding-top: 4px; }
.hero h1 em { padding: .3em .06em .1em; margin: -.3em -.06em -.1em; line-height: 1.2; vertical-align: baseline; }
.hero__content>p { margin-top: 22px; }

/* ===================== Chatbot Trợ lý AI ===================== */
.chatbot { position: fixed; right: 24px; bottom: 24px; z-index: 60; display: flex; flex-direction: column; align-items: flex-end; gap: 12px; font-size: 15px; }
.chatbot__fab { position: relative; width: 74px; height: 74px; border: 0; border-radius: 50%; cursor: pointer; display: grid; place-items: center; color: white;
  background: linear-gradient(145deg, #2a6be0, #1747b5); box-shadow: 0 12px 30px rgba(23,71,181,.45); animation: bot-float 2.6s ease-in-out infinite; }
.chatbot__fab:hover { animation-play-state: paused; transform: scale(1.06); }
.chatbot--open .chatbot__fab { animation: none; width: 60px; height: 60px; }
.chatbot__pulse { position: absolute; inset: 0; border-radius: 50%; border: 3px solid rgba(42,107,224,.55); animation: bot-pulse 2.2s ease-out infinite; pointer-events: none; }
.chatbot--open .chatbot__pulse { display: none; }
.bot-face { display: block; filter: drop-shadow(0 2px 3px rgba(0,0,0,.15)); }
.chatbot__fab .bot-face { animation: bot-tilt 2.6s ease-in-out infinite; }
.bot-face__eyes { transform-origin: 32px 32px; animation: bot-blink 4s infinite; }
.bot-face__antenna { animation: bot-light 1.4s ease-in-out infinite; }
.chatbot__hint { max-width: 250px; border: 0; cursor: pointer; text-align: left; padding: 12px 16px; border-radius: 16px 16px 4px 16px; background: white; color: #13294d; font-size: 14px; font-weight: 500; line-height: 1.45;
  box-shadow: 0 10px 30px rgba(19,41,77,.18); animation: bot-pop .35s ease-out; }
.chatbot__panel { width: min(380px, calc(100vw - 32px)); height: min(560px, calc(100vh - 140px)); display: flex; flex-direction: column; background: rgba(255,255,255,.97); border-radius: 22px; overflow: hidden;
  box-shadow: 0 24px 60px rgba(19,41,77,.28); border: 1px solid rgba(37,84,176,.18); animation: bot-pop .25s ease-out; transform-origin: bottom right; }
.chatbot__head { display: flex; align-items: center; gap: 12px; padding: 14px 16px; background: linear-gradient(135deg, #1f5fd6, #1747b5); color: white; }
.chatbot__avatar { width: 44px; height: 44px; border-radius: 14px; background: rgba(255,255,255,.18); display: grid; place-items: center; }
.chatbot__head > div { flex: 1; display: flex; flex-direction: column; }
.chatbot__head strong { font-size: 16px; }
.chatbot__head small { font-size: 12px; opacity: .9; display: flex; align-items: center; gap: 6px; }
.chatbot__head small i { width: 8px; height: 8px; border-radius: 50%; background: #4ade80; box-shadow: 0 0 0 3px rgba(74,222,128,.25); }
.chatbot__head button { border: 0; background: rgba(255,255,255,.15); color: white; width: 34px; height: 34px; border-radius: 10px; display: grid; place-items: center; cursor: pointer; }
.chatbot__list { flex: 1; overflow-y: auto; padding: 16px; display: flex; flex-direction: column; gap: 10px; background: #f3f8ff; }
.chatbot__msg { max-width: 85%; padding: 10px 14px; border-radius: 16px; line-height: 1.55; font-size: 14.5px; white-space: pre-wrap; }
.chatbot__msg--bot { align-self: flex-start; background: white; color: #13294d; border-bottom-left-radius: 4px; box-shadow: 0 2px 8px rgba(19,41,77,.06); }
.chatbot__msg--user { align-self: flex-end; background: #1f5fd6; color: white; border-bottom-right-radius: 4px; }
.chatbot__typing { display: flex; gap: 5px; padding: 14px; }
.chatbot__typing span { width: 7px; height: 7px; border-radius: 50%; background: #8aa3c4; animation: bot-dot 1s infinite; }
.chatbot__typing span:nth-child(2) { animation-delay: .15s; } .chatbot__typing span:nth-child(3) { animation-delay: .3s; }
.chatbot__quick { display: flex; gap: 8px; overflow-x: auto; padding: 10px 14px 4px; background: white; }
.chatbot__quick button { flex: none; border: 1px solid #cfe0f5; background: #eef5ff; color: #1747b5; font-size: 13px; font-weight: 600; padding: 7px 12px; border-radius: 999px; cursor: pointer; }
.chatbot__quick button:hover { background: #1747b5; color: white; }
.chatbot__input { display: flex; gap: 8px; padding: 10px 14px; background: white; }
.chatbot__input input { flex: 1; min-width: 0; border: 1px solid #d6e3f2; border-radius: 12px; padding: 0 14px; height: 44px; font-size: 14.5px; outline: none; }
.chatbot__input input:focus { border-color: #1f5fd6; box-shadow: 0 0 0 3px rgba(31,95,214,.12); }
.chatbot__input button { width: 44px; height: 44px; border: 0; border-radius: 12px; background: #f47b20; color: white; display: grid; place-items: center; cursor: pointer; }
.chatbot__input button:disabled { opacity: .45; cursor: default; }
.chatbot__note { margin: 0; padding: 0 14px 10px; background: white; font-size: 11px; color: #7a8ea3; text-align: center; }
@keyframes bot-float { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-10px); } }
@keyframes bot-tilt { 0%,100% { transform: rotate(-6deg); } 50% { transform: rotate(6deg); } }
@keyframes bot-pulse { 0% { transform: scale(1); opacity: .9; } 100% { transform: scale(1.6); opacity: 0; } }
@keyframes bot-blink { 0%,44%,50%,100% { transform: scaleY(1); } 47% { transform: scaleY(.1); } }
@keyframes bot-light { 0%,100% { fill: #ff9a1f; } 50% { fill: #ffe066; } }
@keyframes bot-pop { from { opacity: 0; transform: translateY(10px) scale(.96); } to { opacity: 1; transform: none; } }
@keyframes bot-dot { 0%,80%,100% { transform: translateY(0); opacity: .5; } 40% { transform: translateY(-5px); opacity: 1; } }
@media (max-width: 520px) { .chatbot { right: 14px; bottom: 14px; } .chatbot__fab { width: 62px; height: 62px; } .chatbot__panel { height: calc(100vh - 110px); } }
@media (prefers-reduced-motion: reduce) { .chatbot__fab, .chatbot__fab .bot-face, .chatbot__pulse, .bot-face__eyes, .bot-face__antenna { animation: none; } }

/* Số liệu tổng quan */
.stat-card strong { font-size: 19px; font-weight: 800; color: #1747b5; }
.stat-card--pending strong { font-size: 15px; font-weight: 600; color: #8193a5; }
.stats-note { margin: 14px 4px 0; font-size: 14px; line-height: 1.6; color: #2c4256; text-shadow: 0 0 10px rgba(255,255,255,.95), 0 0 4px rgba(255,255,255,.9); }

/* ===================== Bản đồ số (Leaflet) ===================== */
.map-canvas { isolation: isolate; z-index: 0; background: #e8eef2; }
.map-leaflet { position: absolute; inset: 0; border-radius: 16px; font-family: inherit; }
.map-card__tools { display: flex !important; flex-direction: row !important; align-items: center; gap: 8px; }
.map-switch { display: flex !important; flex-direction: row !important; background: #eef4fa; border: 1px solid var(--line); border-radius: 10px; padding: 3px; }
.map-switch button { width: auto; height: auto; display: block; white-space: nowrap; border: 0; background: transparent; color: #47627a; font-size: 13px; font-weight: 600; padding: 6px 12px; border-radius: 8px; cursor: pointer; }
.map-switch button.active { background: white; color: #1747b5; box-shadow: 0 2px 6px rgba(20,60,110,.12); }
.map-full { border: 1px solid var(--line); background: #f7fbfe; border-radius: 9px; width: 36px; height: 36px; display: grid; place-items: center; color: var(--blue); cursor: pointer; }
.map-legend { z-index: 500; }
.legend-line { width: 18px; height: 0; border-top: 3px solid #1747b5; display: inline-block; }
.map-error { position: absolute; inset: 0; display: grid; place-items: center; color: #47627a; font-size: 14px; z-index: 600; }
.map-name-label { background: rgba(255,255,255,.92); border: 0; border-radius: 8px; box-shadow: 0 3px 10px rgba(15,50,100,.18); color: #1747b5; font-weight: 800; font-size: 13px; padding: 4px 10px; }
.map-name-label::before { display: none; }
.map-card__footer a { color: var(--blue); font-size: 13px; font-weight: 700; display: flex; align-items: center; gap: 5px; }
.map-card:fullscreen { border-radius: 0; display: flex; flex-direction: column; transform: none; }
.map-card:fullscreen .map-canvas { flex: 1; height: auto; }
.leaflet-container a { color: #1747b5; }
@media (max-width: 520px) { .map-switch button { padding: 6px 9px; font-size: 12px; } }
.leaflet-container svg, .leaflet-container img { max-width: none !important; max-height: none !important; }
.leaflet-container .leaflet-tile { width: 256px; }

/* ======================================================================
   GIAO DIỆN NỀN XANH NAVY (theo mẫu): ảnh nền phủ xanh đậm, chữ trắng,
   nhãn cam, thẻ trắng nổi. Khối này ghi đè các màu phía trên.
   ====================================================================== */
body { background: #0a2a57; }
.page-bg { opacity: 1; }
.page-bg::after { background: linear-gradient(180deg, rgba(7,32,78,.80) 0%, rgba(9,42,96,.74) 45%, rgba(8,36,84,.82) 100%); }

/* Tiêu đề section, nhãn, link "Xem tất cả" */
.section-heading h2 { color: #fff; font-weight: 800; text-shadow: 0 2px 12px rgba(0,15,40,.35); }
.section-heading .eyebrow { color: #ff8a2b; text-shadow: none; }
.eyebrow:before { background: #ff8a2b; }
.view-all { color: #fff; text-shadow: none; }
.view-all:hover { color: #ffb36b; }

/* Hero */
.welcome { color: #fff; filter: drop-shadow(0 2px 8px rgba(0,15,40,.35)); }
.hero h1 { color: #fff; filter: drop-shadow(0 4px 14px rgba(0,15,40,.4)); position: relative; padding-bottom: 22px; }
.hero h1::after { content: ""; position: absolute; left: 4px; bottom: 0; width: 84px; height: 6px; border-radius: 6px; background: linear-gradient(90deg, #ff7a1a, #ffa23a); }
.hero__content>p { color: rgba(255,255,255,.92); text-shadow: 0 1px 8px rgba(0,15,40,.35); }
.hero-search { border-color: #fff; box-shadow: 0 14px 34px rgba(0,15,40,.3); }
.hero-shortcuts a { background: #fff; border-color: #fff; color: #133a6b; box-shadow: 0 8px 20px rgba(0,15,40,.22); }
.hero-shortcuts a:hover { background: #fff; color: var(--blue); }
.map-card { box-shadow: 0 25px 60px rgba(0,15,40,.4); }

/* Tổng quan: từng ô là một thẻ trắng riêng */
.stats-grid { border: 0; background: transparent; box-shadow: none; overflow: visible; gap: 10px; }
.stat-card { background: #fff; border: 0 !important; border-radius: 14px; box-shadow: 0 10px 26px rgba(0,15,40,.22); padding: 20px 8px; }
.stat-card:hover { background: #fff; transform: translateY(-4px); }
.stat-card strong { color: #0f4fbf; white-space: normal; line-height: 1.25; }
.stats-note { color: rgba(255,255,255,.85); text-shadow: none; }

/* Thẻ trắng đặc hơn trên nền tối */
.utility-card { background: #fff; border-color: #fff; box-shadow: 0 12px 30px rgba(0,15,40,.25); }
.place-card, .featured-news, .news-item { border-color: #fff; box-shadow: 0 12px 30px rgba(0,15,40,.25); }

/* Dải liên hệ cuối trang */
.support-strip { background: #f4f8fd; backdrop-filter: none; }

/* Nền sáng hơn: xanh dương tươi, ảnh rõ hơn (ghi đè lớp navy đậm ở trên) */
body { background: #2a6fd0; }
.page-bg { filter: saturate(1.2) brightness(1.08); }
.page-bg::after { background: linear-gradient(180deg, rgba(28,110,220,.50) 0%, rgba(22,96,205,.46) 40%, rgba(18,82,185,.58) 100%); }
.section-heading h2 { text-shadow: 0 2px 10px rgba(5,35,90,.55), 0 1px 2px rgba(5,35,90,.4); }
.welcome { filter: drop-shadow(0 2px 6px rgba(5,35,90,.6)); }
.hero h1 { filter: drop-shadow(0 3px 10px rgba(5,35,90,.55)); }
.hero__content>p { text-shadow: 0 1px 6px rgba(5,35,90,.7), 0 0 2px rgba(5,35,90,.5); }
.view-all, .stats-note { text-shadow: 0 1px 6px rgba(5,35,90,.6); }
.section-heading .eyebrow { color: #ffb15a; text-shadow: 0 1px 6px rgba(5,35,90,.6); }
.eyebrow:before { background: #ffb15a; }

/* ======================================================================
   GIAO DIỆN SÁNG (theo mẫu mới nhất): ảnh nền sáng, lớp trắng mỏng,
   chữ xanh đậm, nhãn cam, thẻ trắng nổi. Ghi đè các khối màu phía trên.
   ====================================================================== */
body { background: #eaf3fc; }
.page-bg { opacity: 1; filter: saturate(1.12) brightness(1.06); }
.page-bg::after { background: linear-gradient(180deg, rgba(255,255,255,.28) 0%, rgba(244,249,255,.40) 45%, rgba(238,245,255,.52) 100%); }

/* Chữ xanh đậm, quầng trắng mỏng để tách khỏi ảnh */
.section-heading h2 { color: #0b2f6b; text-shadow: 0 0 16px rgba(255,255,255,.95), 0 0 5px rgba(255,255,255,.95); }
.section-heading .eyebrow { color: #f26a12; text-shadow: 0 0 10px rgba(255,255,255,.95), 0 0 3px rgba(255,255,255,.95); }
.eyebrow:before { background: #f26a12; }
.view-all { color: #1747b5; text-shadow: 0 0 10px rgba(255,255,255,.95), 0 0 3px rgba(255,255,255,.95); }
.view-all:hover { color: #0b2f6b; }

.welcome { color: #133f95; filter: drop-shadow(0 0 1.5px #fff) drop-shadow(0 0 1.5px #fff) drop-shadow(0 0 6px rgba(255,255,255,.8)); }
.hero h1 { color: #0e3a8f; filter: drop-shadow(0 0 2px #fff) drop-shadow(0 0 2px #fff) drop-shadow(0 6px 14px rgba(15,50,120,.22)); }
.hero__content>p { color: #13294d; font-weight: 500; text-shadow: 0 0 12px rgba(255,255,255,.95), 0 0 4px rgba(255,255,255,.95); }
.stats-note { color: #1d3550; text-shadow: 0 0 10px rgba(255,255,255,.95), 0 0 3px rgba(255,255,255,.95); }

/* Thẻ: bóng nhẹ hơn trên nền sáng */
.stat-card, .utility-card, .place-card, .featured-news, .news-item { box-shadow: 0 10px 26px rgba(20,60,110,.14); }
.hero-shortcuts a, .hero-search { box-shadow: 0 8px 22px rgba(20,60,110,.14); }
.map-card { box-shadow: 0 22px 50px rgba(14,59,91,.22); }
.page-bg::after { background: linear-gradient(180deg, rgba(255,255,255,.40) 0%, rgba(244,249,255,.42) 45%, rgba(238,245,255,.52) 100%); }
.hero { background: radial-gradient(ellipse 48% 62% at 20% 50%, rgba(255,255,255,.62) 0%, rgba(255,255,255,.35) 45%, rgba(255,255,255,0) 75%); overflow: visible; }
@media (max-width: 820px) { .hero { background: radial-gradient(ellipse 90% 45% at 50% 28%, rgba(255,255,255,.6) 0%, rgba(255,255,255,0) 75%); } }
.page-bg::after { background: linear-gradient(180deg, rgba(255,255,255,.40) 0%, rgba(244,249,255,.46) 45%, rgba(238,245,255,.58) 100%); }
.page-bg::after { background: linear-gradient(180deg, rgba(255,255,255,.55) 0%, rgba(244,249,255,.60) 45%, rgba(238,245,255,.70) 100%); }
.page-bg::after { background: linear-gradient(180deg, rgba(255,255,255,.68) 0%, rgba(244,249,255,.72) 45%, rgba(238,245,255,.80) 100%); }
