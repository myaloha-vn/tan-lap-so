type IconName =
  | "search" | "user" | "menu" | "close" | "arrow" | "pin" | "map" | "file"
  | "heart" | "building" | "camera" | "home" | "users" | "school" | "health"
  | "area" | "park" | "phone" | "chat" | "bot" | "guide" | "calendar"
  | "shield" | "layers" | "megaphone" | "chevron";

function Icon({ name, size = 22 }: { name: IconName; size?: number }) {
  const paths: Record<IconName, React.ReactNode> = {
    search: <><circle cx="11" cy="11" r="7" /><path d="m20 20-4-4" /></>,
    user: <><circle cx="12" cy="8" r="4" /><path d="M4.5 21a7.5 7.5 0 0 1 15 0" /></>,
    menu: <><path d="M4 7h16M4 12h16M4 17h16" /></>,
    close: <><path d="m6 6 12 12M18 6 6 18" /></>,
    arrow: <><path d="M5 12h14M14 7l5 5-5 5" /></>,
    pin: <><path d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z" /><circle cx="12" cy="10" r="2.5" /></>,
    map: <><path d="m3 6 5-3 8 3 5-3v15l-5 3-8-3-5 3V6Z" /><path d="M8 3v15M16 6v15" /></>,
    file: <><path d="M6 3h8l4 4v14H6V3Z" /><path d="M14 3v5h5M9 13h6M9 17h6" /></>,
    heart: <><path d="M20.8 5.8a5.5 5.5 0 0 0-7.8 0L12 6.9l-1.1-1.1a5.5 5.5 0 0 0-7.7 7.8L12 22l8.8-8.4a5.5 5.5 0 0 0 0-7.8Z" /></>,
    building: <><path d="M4 21V9l8-5 8 5v12M8 21v-7h8v7M9 10h.01M15 10h.01" /></>,
    camera: <><path d="M4 7h4l2-3h4l2 3h4v13H4V7Z" /><circle cx="12" cy="13" r="4" /></>,
    home: <><path d="m3 11 9-8 9 8v10h-6v-6H9v6H3V11Z" /></>,
    users: <><circle cx="9" cy="8" r="3" /><circle cx="17" cy="9" r="2.5" /><path d="M3 20a6 6 0 0 1 12 0M14 15a5 5 0 0 1 7 5" /></>,
    school: <><path d="m3 9 9-5 9 5-9 5-9-5Z" /><path d="M7 12v5c3 2 7 2 10 0v-5M21 9v7" /></>,
    health: <><path d="M9 3h6v6h6v6h-6v6H9v-6H3V9h6V3Z" /></>,
    area: <><path d="M4 4h6M4 4v6M20 4h-6M20 4v6M4 20h6M4 20v-6M20 20h-6M20 20v-6" /></>,
    park: <><path d="M12 3 7 10h3l-5 7h6v4h2v-4h6l-5-7h3l-5-7Z" /></>,
    phone: <><path d="M7 3H4v4c0 7.2 5.8 13 13 13h4v-3l-5-2-2 2c-3-1-6-4-7-7l2-2-2-5Z" /></>,
    chat: <><path d="M4 4h16v13H9l-5 4V4Z" /><path d="M8 9h8M8 13h5" /></>,
    bot: <><rect x="4" y="6" width="16" height="13" rx="3" /><path d="M12 2v4M8 11h.01M16 11h.01M8 15h8" /></>,
    guide: <><path d="M4 5c4-2 6 0 8 2v14c-2-2-4-4-8-2V5ZM20 5c-4-2-6 0-8 2v14c2-2 4-4 8-2V5Z" /></>,
    calendar: <><rect x="3" y="5" width="18" height="16" rx="2" /><path d="M8 3v4M16 3v4M3 10h18" /></>,
    shield: <><path d="M12 3 4 6v6c0 5 3.5 8 8 10 4.5-2 8-5 8-10V6l-8-3Z" /><path d="m9 12 2 2 4-4" /></>,
    layers: <><path d="m12 3 9 5-9 5-9-5 9-5Z" /><path d="m3 12 9 5 9-5M3 16l9 5 9-5" /></>,
    megaphone: <><path d="M4 10v4h4l9 4V6L8 10H4ZM8 14l2 6h3" /><path d="M20 9v6" /></>,
    chevron: <><path d="m9 18 6-6-6-6" /></>,
  };
  return <svg aria-hidden="true" width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.8" strokeLinecap="round" strokeLinejoin="round">{paths[name]}</svg>;
}

function Logo({ light = false }: { light?: boolean }) {
  return (
    <div className={`logo ${light ? "logo--light" : ""}`}>
      <div className="logo__mark"><span></span><span></span><span></span></div>
      <div><strong>TÂN LẬP</strong><small>CỔNG THÔNG TIN SỐ</small></div>
    </div>
  );
}

function SectionHeading({ eyebrow, title, action }: { eyebrow: string; title: string; action?: string }) {
  return (
    <div className="section-heading">
      <div>
        <span className="eyebrow">{eyebrow}</span>
        <h2>{title}</h2>
      </div>
      {action && <a className="view-all" href="#tin-tuc">{action}<Icon name="arrow" size={18} /></a>}
    </div>
  );
}

// Cấu hình thanh thông tin: đổi tên địa danh, toạ độ (để lấy thời tiết) và link quản trị tại đây
const SITE = {
  place: "Xã Tân Lập, tỉnh Tây Ninh",
  lat: 11.6778,
  lon: 106.04,
  adminUrl: "#",
};

function weatherLabel(code: number): [string, string] {
  if (code === 0) return ["☀️", "Trời quang"];
  if (code <= 2) return ["🌤️", "Ít mây"];
  if (code === 3) return ["☁️", "Nhiều mây"];
  if (code <= 48) return ["🌫️", "Sương mù"];
  if (code <= 57) return ["🌦️", "Mưa phùn"];
  if (code <= 67) return ["🌧️", "Có mưa"];
  if (code <= 82) return ["🌧️", "Mưa rào"];
  return ["⛈️", "Có dông"];
}

function TopBar() {
  const [now, setNow] = useState(() => new Date());
  const [weather, setWeather] = useState<{ temp: number; code: number } | null>(null);

  useEffect(() => {
    const id = setInterval(() => setNow(new Date()), 1000);
    return () => clearInterval(id);
  }, []);

  useEffect(() => {
    let alive = true;
    const load = () =>
      fetch(`https://api.open-meteo.com/v1/forecast?latitude=${SITE.lat}&longitude=${SITE.lon}&current=temperature_2m,weather_code&timezone=Asia%2FHo_Chi_Minh`)
        .then((r) => r.json())
        .then((d) => { if (alive && d.current) setWeather({ temp: Math.round(d.current.temperature_2m), code: d.current.weather_code }); })
        .catch(() => {});
    load();
    const id = setInterval(load, 15 * 60 * 1000);
    return () => { alive = false; clearInterval(id); };
  }, []);

  const tz = "Asia/Ho_Chi_Minh";
  const time = new Intl.DateTimeFormat("vi-VN", { hour: "2-digit", minute: "2-digit", hour12: false, timeZone: tz }).format(now);
  const weekday = new Intl.DateTimeFormat("vi-VN", { weekday: "long", timeZone: tz }).format(now);
  const date = new Intl.DateTimeFormat("vi-VN", { day: "2-digit", month: "2-digit", year: "numeric", timeZone: tz }).format(now);
  const [wIcon, wText] = weather ? weatherLabel(weather.code) : ["🌤️", "Đang tải thời tiết"];

  return (
    <div className="topbar-wrap">
      <div className="topbar">
        <div className="topbar__time"><strong>{time}</strong><span>Giờ địa phương</span></div>
        <i className="topbar__sep" />
        <span className="topbar__date">{weekday.charAt(0).toUpperCase() + weekday.slice(1)}, {date}</span>
        <i className="topbar__sep topbar__sep--date" />
        <span>{wIcon} {weather ? `${weather.temp}°C · ${wText}` : wText}</span>
        <i className="topbar__sep topbar__sep--place" />
        <span className="topbar__place">📍 {SITE.place}</span>
        <a className="topbar__admin" href={SITE.adminUrl}>Truy cập trang quản trị →</a>
      </div>
    </div>
  );
}

/* ===================== Bản đồ số: ranh giới thật xã Tân Lập =====================
   Ranh giới lấy từ OpenStreetMap (relation 15801674), lưu ở src/data/tan-lap-boundary.json.
   Thư viện bản đồ Leaflet 1.9.4 được đặt sẵn trong public/vendor/leaflet (không phụ thuộc CDN). */
const LEAFLET_VER = "1.9.4";
let leafletPromise: Promise<any> | null = null;
function loadLeaflet(): Promise<any> {
  const w = window as any;
  if (w.L) return Promise.resolve(w.L);
  if (leafletPromise) return leafletPromise;
  leafletPromise = new Promise((resolve, reject) => {
    const css = document.createElement("link");
    css.rel = "stylesheet";
    css.href = `${import.meta.env.BASE_URL}vendor/leaflet/leaflet.css?v=${LEAFLET_VER}`;
    document.head.appendChild(css);
    const js = document.createElement("script");
    js.src = `${import.meta.env.BASE_URL}vendor/leaflet/leaflet.js?v=${LEAFLET_VER}`;
    js.onload = () => resolve(w.L);
    js.onerror = reject;
    document.head.appendChild(js);
  });
  return leafletPromise;
}

const MAP_LAYERS = {
  map: { url: "https://server.arcgisonline.com/ArcGIS/rest/services/World_Street_Map/MapServer/tile/{z}/{y}/{x}", attr: "Bản đồ &copy; Esri; ranh giới &copy; <a href=\"https://www.openstreetmap.org/copyright\">OpenStreetMap</a>" },
  satellite: { url: "https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}", attr: "Ảnh vệ tinh &copy; Esri; ranh giới &copy; OpenStreetMap" },
};

function DigitalMap() {
  const boxRef = useRef<HTMLDivElement>(null);
  const cardRef = useRef<HTMLDivElement>(null);
  const mapRef = useRef<any>(null);
  const tileRef = useRef<any>(null);
  const [layer, setLayer] = useState<"map" | "satellite">("map");
  const [failed, setFailed] = useState(false);

  useEffect(() => {
    let cancelled = false;
    loadLeaflet().then((L) => {
      if (cancelled || !boxRef.current || mapRef.current) return;
      const map = L.map(boxRef.current, { zoomControl: false, scrollWheelZoom: false, attributionControl: true });
      map.attributionControl.setPrefix('<a href="https://leafletjs.com" target="_blank" rel="noopener">Leaflet</a>');
      mapRef.current = map;
      L.control.zoom({ position: "topright", zoomInTitle: "Phóng to", zoomOutTitle: "Thu nhỏ" }).addTo(map);
      tileRef.current = L.tileLayer(MAP_LAYERS.map.url, { attribution: MAP_LAYERS.map.attr, maxZoom: 19 }).addTo(map);
      const ring = (boundary as any).geometry.coordinates[0].map(([x, y]: number[]) => [y, x]);
      const area = L.polygon(ring, { color: "#1747b5", weight: 3, fillColor: "#3b82f6", fillOpacity: 0.16 }).addTo(map);
      area.bindTooltip("Xã Tân Lập", { permanent: true, direction: "center", className: "map-name-label" });
      area.bindPopup("<strong>Xã Tân Lập, tỉnh Tây Ninh</strong><br/>Diện tích: 257,61 km²<br/>Dân số (2025): 16.810 người<br/>Trụ sở UBND: Tổ 14, ấp Tân Hòa");
      const fit = () => { map.invalidateSize(); map.fitBounds(area.getBounds(), { padding: [18, 18] }); };
      fit();
      setTimeout(fit, 200);
      // Khung bản đồ đổi kích thước (xoay màn hình, toàn màn hình...) thì canh lại
      const ro = new ResizeObserver(() => fit());
      ro.observe(boxRef.current);
      (map as any)._ro = ro;
    }).catch(() => setFailed(true));
    return () => { cancelled = true; if (mapRef.current) { mapRef.current._ro?.disconnect(); mapRef.current.remove(); mapRef.current = null; } };
  }, []);

  useEffect(() => {
    const L = (window as any).L;
    if (!L || !mapRef.current || !tileRef.current) return;
    mapRef.current.removeLayer(tileRef.current);
    const cfg = MAP_LAYERS[layer];
    tileRef.current = L.tileLayer(cfg.url, { attribution: cfg.attr, maxZoom: 19 }).addTo(mapRef.current);
    tileRef.current.bringToBack();
  }, [layer]);

  const toggleFull = () => {
    const el = cardRef.current;
    if (!el) return;
    if (document.fullscreenElement) document.exitFullscreen(); else el.requestFullscreen?.();
    setTimeout(() => mapRef.current?.invalidateSize(), 300);
  };

  return (
    <div className="map-card" ref={cardRef}>
      <div className="map-card__head">
        <div><span>BẢN ĐỒ SỐ</span><strong>Xã Tân Lập</strong></div>
        <div className="map-card__tools">
          <div className="map-switch" role="group" aria-label="Chọn lớp bản đồ">
            <button className={layer === "map" ? "active" : ""} onClick={() => setLayer("map")}>Bản đồ</button>
            <button className={layer === "satellite" ? "active" : ""} onClick={() => setLayer("satellite")}>Vệ tinh</button>
          </div>
          <button className="map-full" aria-label="Xem toàn màn hình" onClick={toggleFull}><Icon name="area" size={19} /></button>
        </div>
      </div>
      <div className="map-canvas">
        <div ref={boxRef} className="map-leaflet" />
        {failed && <div className="map-error">Không tải được bản đồ. Vui lòng kiểm tra kết nối mạng.</div>}
        <div className="map-legend"><strong>Chú giải</strong><span><i className="legend-line"></i>Ranh giới xã</span><span>Diện tích 257,61 km²</span></div>
      </div>
      <div className="map-card__footer"><span><Icon name="layers" size={16} /> Dữ liệu ranh giới: OpenStreetMap</span><a href="https://www.openstreetmap.org/relation/15801674" target="_blank" rel="noopener noreferrer">Xem bản đồ đầy đủ <Icon name="arrow" size={17} /></a></div>
    </div>
  );
}

function Hero() {
  return (
    <section className="hero">
      <div className="container hero__inner">
        <div className="hero__content">
          <span className="welcome">Chào mừng bạn đến với</span>
          <h1>TÂN LẬP <em>SỐ</em></h1>
          <p>Cổng thông tin số gần gũi, minh bạch và tiện ích — kết nối chính quyền với người dân, đồng hành xây dựng Tân Lập văn minh, hiện đại.</p>
          <div className="hero-search">
            <Icon name="search" size={21} />
            <input aria-label="Tìm kiếm thông tin" placeholder="Tìm thủ tục, địa điểm, tin tức..." />
            <button>Tìm kiếm</button>
          </div>
          <div className="hero-shortcuts">
            {[["file","Dịch vụ công"],["map","Bản đồ số"],["megaphone","Phản ánh"],["phone","Liên hệ"]].map(([icon, label]) => (
              <a href="#" key={label}><span><Icon name={icon as IconName} size={21} /></span>{label}</a>
            ))}
          </div>
        </div>
        <div className="hero__map"><DigitalMap /></div>
      </div>
    </section>
  );
}

// Số liệu tổng quan xã Tân Lập (Tây Ninh) — nguồn: tinhthanhvn.com, dân số năm 2025; mục "Đang cập nhật" chưa có số liệu
const stats: [IconName, string, string][] = [
  ["users","Dân số (2025)","16.810 người"], ["area","Diện tích","257,61 km²"], ["layers","Mật độ dân số","65 người/km²"],
  ["building","Hợp nhất từ","2 xã"], ["shield","Mã ĐVHC","25489"], ["file","Mã bưu chính","80409"],
  ["home","Hộ dân","Đang cập nhật"], ["school","Trường học","Đang cập nhật"], ["health","Cơ sở y tế","Đang cập nhật"],
];

function Stats() {
  return (
    <section className="stats-section">
      <div className="container">
        <SectionHeading eyebrow="TỔNG QUAN" title="Tân Lập qua những con số" />
        <div className="stats-grid">
          {stats.map(([icon,label,value], i) => <div className={`stat-card ${value === "Đang cập nhật" ? "stat-card--pending" : ""}`} key={label}><span className={`stat-icon stat-icon--${i%4}`}><Icon name={icon} /></span><strong>{value}</strong><small>{label}</small></div>)}
        </div>
        <p className="stats-note">Xã Tân Lập được thành lập từ ngày 01/07/2025 trên cơ sở hợp nhất xã Tân Lập (huyện Tân Biên cũ) và xã Thạnh Bắc theo Nghị quyết số 202/2025/QH15. Trụ sở UBND: Tổ 14, ấp Tân Hòa. Nguồn số liệu: tinhthanhvn.com.</p>
      </div>
    </section>
  );
}

