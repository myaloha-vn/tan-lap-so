function News() {
  return (
    <section className="section news" id="tin-tức">
      <div className="container">
        <SectionHeading eyebrow="CẬP NHẬT MỖI NGÀY" title="Tin tức – Thông báo" action="Xem tất cả tin" />
        <div className="news-layout">
          <article className="featured-news">
            <div className="featured-news__image"><img src={photos.heritage} alt="" /><span>TIN NỔI BẬT</span></div>
            <div className="featured-news__body"><div className="date"><Icon name="calendar" size={16} /> Ngày đăng đang cập nhật</div><h3>Chung tay xây dựng Tân Lập ngày càng văn minh, hiện đại và đáng sống</h3><p>Cập nhật hoạt động nổi bật, những chuyển biến tích cực và câu chuyện đẹp từ cộng đồng địa phương.</p><a href="#">Đọc bài viết <Icon name="arrow" size={18} /></a></div>
          </article>
          <div className="news-list">
            {smallNews.map(([title,date,image],i) => <article className="news-item" key={i}><img src={image} alt="" /><div><span><Icon name="calendar" size={14} /> {date}</span><h3>{title}</h3><a href="#">Xem chi tiết <Icon name="chevron" size={14} /></a></div></article>)}
          </div>
        </div>
      </div>
    </section>
  );
}

function Footer() {
  return (
    <>
      <section className="support-strip">
        <div className="container support-grid">
          {[["chat","Zalo Tân Lập","Kết nối nhanh"],["bot","Trợ lý AI","Hỏi đáp 24/7"],["guide","Hướng dẫn","Dễ dàng sử dụng"],["phone","Liên hệ","Luôn lắng nghe"]].map(([icon,title,desc]) => <a href={title === "Trợ lý AI" ? "#tro-ly-ai" : "#"} key={title}><span><Icon name={icon as IconName} /></span><div><strong>{title}</strong><small>{desc}</small></div><Icon name="chevron" size={18} /></a>)}
        </div>
      </section>
      <footer className="footer">
        <div className="container footer__top">
          <div className="footer__brand"><Logo light /><p>Cổng thông tin số phục vụ người dân, đồng hành cùng sự phát triển của địa phương.</p><div className="footer__badge"><Icon name="shield" size={18} /> Thông tin chính thống</div></div>
          <div><h4>Khám phá</h4><a href="#">Giới thiệu</a><a href="#">Khu phố số</a><a href="#">Bản đồ quy hoạch</a><a href="#">Du lịch Tân Lập</a></div>
          <div><h4>Hỗ trợ người dân</h4><a href="#">Dịch vụ công</a><a href="#">Phản ánh kiến nghị</a><a href="#">Câu hỏi thường gặp</a><a href="#">Chính sách bảo mật</a></div>
          <div className="footer__contact"><h4>Thông tin liên hệ</h4><p><Icon name="pin" size={19} /> Tổ 14, ấp Tân Hòa, xã Tân Lập, tỉnh Tây Ninh</p><p><Icon name="phone" size={19} /> Thông tin đang cập nhật</p><p><Icon name="calendar" size={19} /> Thứ Hai – Thứ Sáu</p></div>
        </div>
        <div className="container footer__bottom"><span>© Cổng thông tin Tân Lập Số.</span><span>Vì người dân · Phục vụ người dân</span></div>
      </footer>
    </>
  );
}


/* ===================== Trợ lý AI (chatbot góc màn hình) =====================
   Hiện đang trả lời theo bộ câu hỏi mẫu (FAQ) ngay trên trình duyệt.
   Khi có API AI thật, chỉ cần sửa hàm askAssistant() bên dưới để gọi API. */
type ChatMsg = { from: "bot" | "user"; text: string };

const QUICK_QUESTIONS = ["Thủ tục hành chính", "Gửi phản ánh", "Giờ làm việc", "Thông tin liên hệ"];

const FAQ: { keys: string[]; answer: string }[] = [
  { keys: ["thủ tục", "dịch vụ công", "hồ sơ", "giấy tờ", "chứng thực", "khai sinh", "hộ tịch"], answer: "Anh/chị có thể nộp hồ sơ trực tuyến tại mục **Dịch vụ công** trên trang này, hoặc đến Bộ phận Một cửa của xã trong giờ hành chính. Anh/chị cần làm thủ tục gì để tôi hướng dẫn cụ thể hơn?" },
  { keys: ["phản ánh", "kiến nghị", "khiếu nại", "sự cố", "góp ý"], answer: "Anh/chị bấm vào **Phản ánh** ở phần Tiện ích nhanh, mô tả sự việc và đính kèm hình ảnh (nếu có). Phản ánh sẽ được chuyển đến bộ phận phụ trách và phản hồi qua số điện thoại anh/chị cung cấp." },
  { keys: ["giờ", "làm việc", "mở cửa", "thời gian"], answer: "Bộ phận Một cửa làm việc từ **Thứ Hai đến Thứ Sáu**. Giờ làm việc cụ thể đang được cập nhật, anh/chị vui lòng xem thêm tại mục Liên hệ." },
  { keys: ["liên hệ", "số điện thoại", "hotline", "địa chỉ", "email"], answer: "Thông tin liên hệ của UBND xã nằm ở cuối trang (mục **Thông tin liên hệ**). Anh/chị cũng có thể kết nối nhanh qua **Zalo Tân Lập**." },
  { keys: ["bản đồ", "quy hoạch", "đất", "khu phố"], answer: "Anh/chị xem **Bản đồ số** ngay ở đầu trang hoặc mục **Quy hoạch** trong Tiện ích nhanh để tra cứu thông tin khu phố và quy hoạch." },
  { keys: ["xin chào", "chào", "hello", "hi"], answer: "Xin chào anh/chị! Tôi là Trợ lý AI của Tân Lập Số. Tôi có thể hỗ trợ về thủ tục hành chính, phản ánh kiến nghị, thông tin liên hệ và tiện ích của xã." },
];

async function askAssistant(question: string): Promise<string> {
  const q = question.toLowerCase();
  const hit = FAQ.find((f) => f.keys.some((k) => q.includes(k)));
  await new Promise((r) => setTimeout(r, 700));
  return hit ? hit.answer : "Cảm ơn anh/chị đã đặt câu hỏi. Hiện tôi chưa có thông tin cho nội dung này, anh/chị vui lòng liên hệ trực tiếp Bộ phận Một cửa hoặc gửi **Phản ánh** để được cán bộ hỗ trợ.";
}

function renderBold(text: string) {
  return text.split(/(\*\*[^*]+\*\*)/g).map((part, i) =>
    part.startsWith("**") ? <strong key={i}>{part.slice(2, -2)}</strong> : <span key={i}>{part}</span>
  );
}

function BotFace({ size = 56 }: { size?: number }) {
  return (
    <svg className="bot-face" width={size} height={size} viewBox="0 0 64 64" aria-hidden="true">
      <line x1="32" y1="6" x2="32" y2="14" stroke="#1747b5" strokeWidth="3" strokeLinecap="round" />
      <circle className="bot-face__antenna" cx="32" cy="6" r="4" fill="#ff9a1f" />
      <rect x="8" y="14" width="48" height="40" rx="16" fill="#fff" stroke="#1747b5" strokeWidth="3" />
      <rect x="14" y="22" width="36" height="22" rx="11" fill="#1747b5" />
      <g className="bot-face__eyes" fill="#7ef0ff"><ellipse cx="24" cy="32" rx="4" ry="5" /><ellipse cx="40" cy="32" rx="4" ry="5" /></g>
      <path d="M26 39 Q32 43 38 39" stroke="#7ef0ff" strokeWidth="2.4" strokeLinecap="round" fill="none" />
      <rect x="2" y="28" width="6" height="12" rx="3" fill="#ff9a1f" /><rect x="56" y="28" width="6" height="12" rx="3" fill="#ff9a1f" />
    </svg>
  );
}

function ChatBot() {
  const [open, setOpen] = useState(false);
  const [hint, setHint] = useState(false);
  const [typing, setTyping] = useState(false);
  const [input, setInput] = useState("");
  const [messages, setMessages] = useState<ChatMsg[]>([
    { from: "bot", text: "Xin chào! Tôi là **Trợ lý AI Tân Lập Số**. Anh/chị cần hỗ trợ gì hôm nay?" },
  ]);
  const listRef = useRef<HTMLDivElement>(null);

  // Lời chào bật lên định kỳ khi khung chat đang đóng
  useEffect(() => {
    if (open) { setHint(false); return; }
    const show = setTimeout(() => setHint(true), 2500);
    const cycle = setInterval(() => setHint((h) => !h), 7000);
    return () => { clearTimeout(show); clearInterval(cycle); };
  }, [open]);

  // Mở chatbot khi bấm link "#tro-ly-ai" (ví dụ ô Trợ lý AI ở cuối trang)
  useEffect(() => {
    const onClick = (e: MouseEvent) => {
      const a = (e.target as HTMLElement).closest('a[href="#tro-ly-ai"]');
      if (a) { e.preventDefault(); setOpen(true); }
    };
    document.addEventListener("click", onClick);
    return () => document.removeEventListener("click", onClick);
  }, []);

  useEffect(() => { listRef.current?.scrollTo({ top: listRef.current.scrollHeight, behavior: "smooth" }); }, [messages, typing, open]);

  const send = async (text: string) => {
    const q = text.trim();
    if (!q || typing) return;
    setMessages((m) => [...m, { from: "user", text: q }]);
    setInput("");
    setTyping(true);
    const answer = await askAssistant(q);
    setTyping(false);
    setMessages((m) => [...m, { from: "bot", text: answer }]);
  };

  return (
    <div className={`chatbot ${open ? "chatbot--open" : ""}`}>
      {open && (
        <div className="chatbot__panel" role="dialog" aria-label="Trợ lý AI Tân Lập Số">
          <div className="chatbot__head">
            <span className="chatbot__avatar"><BotFace size={34} /></span>
            <div><strong>Trợ lý AI Tân Lập</strong><small><i />Đang trực tuyến</small></div>
            <button aria-label="Đóng trợ lý" onClick={() => setOpen(false)}><Icon name="close" size={20} /></button>
          </div>
          <div className="chatbot__list" ref={listRef}>
            {messages.map((m, i) => <div key={i} className={`chatbot__msg chatbot__msg--${m.from}`}>{renderBold(m.text)}</div>)}
            {typing && <div className="chatbot__msg chatbot__msg--bot chatbot__typing"><span /><span /><span /></div>}
          </div>
          <div className="chatbot__quick">
            {QUICK_QUESTIONS.map((q) => <button key={q} onClick={() => send(q)}>{q}</button>)}
          </div>
          <form className="chatbot__input" onSubmit={(e) => { e.preventDefault(); send(input); }}>
            <input value={input} onChange={(e) => setInput(e.target.value)} placeholder="Nhập câu hỏi của anh/chị..." aria-label="Nhập câu hỏi" />
            <button type="submit" aria-label="Gửi" disabled={!input.trim() || typing}><Icon name="arrow" size={20} /></button>
          </form>
          <p className="chatbot__note">Trợ lý AI có thể chưa chính xác, vui lòng kiểm tra lại với cán bộ xã.</p>
        </div>
      )}
      {!open && hint && <button className="chatbot__hint" onClick={() => setOpen(true)}>Xin chào! 👋 Tôi có thể giúp gì cho anh/chị?</button>}
      <button className="chatbot__fab" aria-label={open ? "Đóng trợ lý AI" : "Mở trợ lý AI"} onClick={() => setOpen(!open)}>
        <span className="chatbot__pulse" />
        {open ? <Icon name="close" size={28} /> : <BotFace />}
      </button>
    </div>
  );
}

export default function App() {
  return <><div className="page-bg" aria-hidden="true" style={{ backgroundImage: `url(${photos.hero})` }} /><TopBar /><main><Hero /><Stats /><Utilities /><Explore /><News /></main><Footer /><ChatBot /></>;
}
