/* =====================================================================
   CSS CHO CÁC TRANG CON — cùng tông giao diện sáng của trang chủ
   ===================================================================== */
:root { --card: #fff; --text: #13294d; --muted-2: #5d7385; --brand: #1747b5; --brand-2: #0e3a8f; --accent: #f26a12; --ok: #16a34a; --warn: #d97706; }

/* ---------- Thanh điều hướng các mục ---------- */
.subnav { position: relative; z-index: 30; padding: 12px 0 0; }
.subnav__inner { display: flex; align-items: center; gap: 18px; background: rgba(255,255,255,.92); border: 1px solid rgba(37,84,176,.16); border-radius: 18px; padding: 10px 16px; box-shadow: 0 8px 24px rgba(20,60,110,.10); backdrop-filter: blur(10px); }
.subnav__brand .logo { transform: scale(.88); transform-origin: left center; }
.subnav__links { display: flex; flex-wrap: wrap; gap: 4px; margin-left: auto; }
.subnav__links a { padding: 8px 12px; border-radius: 10px; font-size: 14px; font-weight: 600; color: #2b4664; transition: .2s; white-space: nowrap; }
.subnav__links a:hover { background: #eef5ff; color: var(--brand); }
.subnav__links a.active { background: var(--brand); color: #fff; }
.subnav__toggle { display: none; margin-left: auto; border: 0; background: #eef5ff; color: var(--brand); width: 42px; height: 42px; border-radius: 12px; place-items: center; cursor: pointer; }

/* ---------- Đầu trang con ---------- */
.subpage { padding-bottom: 56px; min-height: 60vh; }
.page-hero { padding: 34px 0 26px; }
.page-hero h1 { margin: 8px 0 10px; font-size: clamp(30px, 3.4vw, 46px); line-height: 1.15; font-weight: 800; color: #0b2f6b; letter-spacing: -.5px; text-shadow: 0 0 16px rgba(255,255,255,.95), 0 0 5px rgba(255,255,255,.95); }
.page-hero p { max-width: 760px; margin: 0; font-size: 17px; line-height: 1.7; color: #1d3550; font-weight: 500; text-shadow: 0 0 12px rgba(255,255,255,.95), 0 0 4px rgba(255,255,255,.95); }
.page-hero .eyebrow { color: var(--accent); text-shadow: 0 0 10px rgba(255,255,255,.95); }
.breadcrumb { display: flex; flex-wrap: wrap; align-items: center; gap: 4px; font-size: 14px; color: #3b5571; margin-bottom: 8px; }
.breadcrumb a { color: var(--brand); font-weight: 600; }
.breadcrumb span { display: inline-flex; align-items: center; gap: 4px; }
.breadcrumb b { color: #13294d; font-weight: 600; }
.hero-kpis { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 18px; }
.hero-kpis div { background: #fff; border-radius: 14px; padding: 12px 18px; box-shadow: 0 8px 20px rgba(20,60,110,.12); min-width: 120px; }
.hero-kpis strong { display: block; font-size: 24px; color: var(--brand); font-weight: 800; }
.hero-kpis small { color: var(--muted-2); font-size: 13px; }
.meta-row { display: flex; flex-wrap: wrap; gap: 16px; margin-top: 12px; font-size: 14px; color: #3b5571; }
.meta-row span, .link-btn { display: inline-flex; align-items: center; gap: 6px; }
.link-btn { border: 0; background: none; color: var(--brand); font-weight: 600; cursor: pointer; font-size: 14px; padding: 0; }

/* ---------- Bố cục ---------- */
.page-grid { display: grid; grid-template-columns: minmax(0, 1fr) 340px; gap: 22px; align-items: start; }
.page-main, .page-side { display: flex; flex-direction: column; gap: 18px; min-width: 0; }
.card { background: var(--card); border-radius: 18px; padding: 22px; box-shadow: 0 10px 26px rgba(20,60,110,.12); border: 1px solid #e6eef7; }
.card__title { margin: 0 0 14px; font-size: 19px; font-weight: 800; color: #0b2f6b; }
.block { margin: 26px 0; }
.block__title { margin: 0 0 14px; font-size: 26px; font-weight: 800; color: #0b2f6b; text-shadow: 0 0 14px rgba(255,255,255,.95), 0 0 4px rgba(255,255,255,.95); }
.muted { color: var(--muted-2); }
.small { font-size: 13px; }
.pending { color: #8193a5 !important; font-weight: 600 !important; }
.source-note { font-size: 13px; color: var(--muted-2); border-top: 1px dashed #d6e3f2; padding-top: 10px; margin-top: 8px; }
code { background: #eef4fb; padding: 1px 6px; border-radius: 6px; font-size: .9em; }

/* ---------- Nút & trường nhập ---------- */
.btn { display: inline-flex; align-items: center; justify-content: center; gap: 8px; height: 44px; padding: 0 18px; border-radius: 12px; border: 1px solid transparent; font-size: 15px; font-weight: 700; cursor: pointer; transition: .2s; text-decoration: none; }
.btn--primary { background: var(--brand); color: #fff; box-shadow: 0 6px 16px rgba(23,71,181,.25); }
.btn--primary:hover { background: var(--brand-2); }
.btn--ghost { background: #eef5ff; color: var(--brand); border-color: #d6e5f7; }
.btn--ghost:hover { background: #e0edff; }
.btn--block { width: 100%; margin-top: 10px; }
.btn--lg { height: 52px; font-size: 16px; padding: 0 26px; margin-top: 8px; }
.btn:disabled { opacity: .6; cursor: default; }
.btn-row { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 10px; }
.btn-row.center { justify-content: center; }
.field { display: flex; flex-direction: column; gap: 6px; margin-bottom: 14px; flex: 1; min-width: 0; }
.field > span { font-size: 14px; font-weight: 600; color: #2b4664; }
.field input, .field select, .field textarea { width: 100%; border: 1px solid #d0deee; border-radius: 12px; padding: 11px 14px; font-size: 15px; color: var(--text); background: #fbfdff; outline: none; transition: .2s; font-family: inherit; }
.field textarea { resize: vertical; min-height: 110px; }
.field input:focus, .field select:focus, .field textarea:focus { border-color: var(--brand); box-shadow: 0 0 0 3px rgba(23,71,181,.12); background: #fff; }
.field em, .err { font-style: normal; font-size: 13px; color: #dc2626; }
.field--err input, .field--err textarea, .field--err select, .field--err .dropzone { border-color: #f19a9a; }
.field .counter { align-self: flex-end; font-size: 12px; color: var(--muted-2); margin-top: -2px; }
.field-row { display: flex; gap: 14px; }
.check { display: flex; gap: 10px; align-items: flex-start; font-size: 14px; color: #2b4664; margin: 6px 0; line-height: 1.5; }
.check input { margin-top: 3px; width: 18px; height: 18px; accent-color: var(--brand); }
.check a { color: var(--brand); font-weight: 600; }

/* ---------- Tabs, chip, toolbar ---------- */
.tabs { display: flex; flex-wrap: wrap; gap: 8px; margin: 6px 0 14px; }
.tabs button { border: 1px solid #d6e3f2; background: #fff; color: #2b4664; font-weight: 700; font-size: 14px; padding: 9px 16px; border-radius: 999px; cursor: pointer; display: inline-flex; align-items: center; gap: 8px; box-shadow: 0 3px 10px rgba(20,60,110,.06); }
.tabs button i { font-style: normal; background: #eef4fb; color: var(--brand); border-radius: 999px; padding: 1px 8px; font-size: 12px; }
.tabs button.active { background: var(--brand); color: #fff; border-color: var(--brand); }
.tabs button.active i { background: rgba(255,255,255,.22); color: #fff; }
.tab-desc { color: #2b4664; margin: 0 0 14px; font-weight: 500; }
.chip-row { display: flex; flex-wrap: wrap; gap: 10px; }
.chip { border: 1px solid #d6e3f2; background: #fff; padding: 10px 16px; border-radius: 14px; font-weight: 700; color: #2b4664; cursor: pointer; display: inline-flex; gap: 8px; align-items: center; box-shadow: 0 4px 12px rgba(20,60,110,.06); }
.chip i { font-style: normal; color: var(--brand); }
.chip.active { background: var(--brand); color: #fff; border-color: var(--brand); }
.chip.active i { color: #fff; }
.toolbar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 6px; }
.toolbar .tabs { margin: 0; }
.view-toggle { display: flex; background: #fff; border-radius: 12px; padding: 4px; box-shadow: 0 3px 10px rgba(20,60,110,.08); }
.view-toggle button { border: 0; background: transparent; padding: 8px 14px; border-radius: 9px; font-weight: 700; color: #47627a; cursor: pointer; display: inline-flex; gap: 6px; align-items: center; }
.view-toggle button.active { background: #eef5ff; color: var(--brand); }
.seg { display: flex; background: #eef4fa; border-radius: 12px; padding: 4px; margin-bottom: 14px; }
.seg button { flex: 1; border: 0; background: transparent; padding: 9px 6px; border-radius: 9px; font-weight: 700; font-size: 14px; color: #47627a; cursor: pointer; }
.seg button.active { background: #fff; color: var(--brand); box-shadow: 0 2px 6px rgba(20,60,110,.12); }
.page-search, .inline-search { display: flex; align-items: center; gap: 10px; background: #fff; border: 1px solid #d6e3f2; border-radius: 14px; padding: 6px 6px 6px 16px; color: #7c91a1; box-shadow: 0 8px 22px rgba(20,60,110,.12); }
.page-search { max-width: 640px; margin-top: 18px; height: 58px; }
.page-search input, .inline-search input { flex: 1; min-width: 0; border: 0; outline: 0; font-size: 16px; color: var(--text); background: transparent; font-family: inherit; }
.inline-search { height: 46px; min-width: 260px; box-shadow: 0 3px 10px rgba(20,60,110,.06); }
.inline-search--lg { height: 56px; max-width: 620px; margin-bottom: 14px; }

/* ---------- Thông báo / trạng thái ---------- */
.demo-notice { display: flex; gap: 10px; align-items: flex-start; background: #fff8eb; border: 1px solid #fcd9a4; color: #7a4a06; padding: 12px 16px; border-radius: 14px; font-size: 14px; line-height: 1.55; margin: 12px 0 16px; }
.demo-notice svg { flex: none; margin-top: 1px; }
.empty-state { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 8px; background: #fff; border: 1px dashed #c9d9ec; border-radius: 18px; padding: 34px 22px; color: var(--muted-2); }
.empty-state > span { width: 60px; height: 60px; border-radius: 18px; background: #eef5ff; color: var(--brand); display: grid; place-items: center; }
.empty-state strong { color: #0b2f6b; font-size: 17px; }
.empty-state p { margin: 0; max-width: 520px; line-height: 1.6; }
.empty-state a { color: var(--brand); font-weight: 700; }
.result { display: flex; gap: 10px; align-items: flex-start; border-radius: 14px; padding: 14px; margin-top: 14px; font-size: 14px; line-height: 1.55; }
.result > div { display: flex; flex-direction: column; gap: 4px; }
.result a { color: var(--brand); font-weight: 700; display: inline-flex; align-items: center; gap: 4px; margin-top: 4px; }
.result--ok { background: #ecfdf3; border: 1px solid #a7e3bf; color: #14532d; }
.result--warn { background: #fff8eb; border: 1px solid #fcd9a4; color: #7a4a06; }
.result--error { background: #fef2f2; border: 1px solid #f8b4b4; color: #991b1b; }
.callout { display: flex; gap: 12px; background: #f1f6ff; border-left: 4px solid var(--brand); padding: 14px 16px; border-radius: 12px; margin-top: 16px; font-size: 15px; line-height: 1.6; color: #1d3550; }
.callout svg { flex: none; color: var(--brand); margin-top: 2px; }
.tag { display: inline-flex; align-items: center; font-size: 12px; font-weight: 700; padding: 4px 10px; border-radius: 999px; background: #eef4fb; color: var(--brand); white-space: nowrap; }
.tag--ok { background: #e7f8ee; color: #15803d; }
.tag--warn { background: #fff4e0; color: #b45309; }
.tag--muted { background: #f1f4f8; color: #64748b; }

/* ---------- Thẻ thông tin ---------- */
.fact-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; }
.fact { display: flex; gap: 12px; align-items: center; background: #f6f9fd; border-radius: 14px; padding: 14px; }
.fact > span { width: 42px; height: 42px; border-radius: 12px; background: #e7f0ff; color: var(--brand); display: grid; place-items: center; flex: none; }
.fact small { display: block; font-size: 13px; color: var(--muted-2); }
.fact strong { font-size: 17px; color: #0b2f6b; }
.article p { font-size: 16px; line-height: 1.8; color: #1f3550; margin: 0 0 12px; }
.article h3 { font-size: 19px; color: #0b2f6b; margin: 18px 0 8px; }
.article h3:first-child { margin-top: 0; }
.article .lead { font-size: 17px; font-weight: 600; color: #13294d; }
.field-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; }
.field-card { display: flex; flex-direction: column; gap: 6px; padding: 16px; border-radius: 14px; background: #f6f9fd; border: 1px solid #e3ecf6; transition: .2s; }
.field-card:hover { background: #fff; box-shadow: 0 10px 22px rgba(20,60,110,.12); transform: translateY(-3px); }
.field-card > span { width: 44px; height: 44px; border-radius: 12px; background: #fff; color: var(--brand); display: grid; place-items: center; box-shadow: 0 3px 8px rgba(20,60,110,.08); }
.field-card strong { font-size: 16px; color: #0b2f6b; }
.field-card p { margin: 0; font-size: 14px; color: var(--muted-2); line-height: 1.55; }
.field-card em { font-style: normal; color: var(--brand); font-weight: 700; font-size: 14px; display: inline-flex; gap: 4px; align-items: center; }
.contact-list { list-style: none; padding: 0; margin: 0 0 6px; display: flex; flex-direction: column; gap: 12px; }
.contact-list li { display: flex; gap: 12px; align-items: flex-start; }
.contact-list li > svg { color: var(--brand); flex: none; margin-top: 3px; }
.contact-list small { display: block; font-size: 12px; color: var(--muted-2); text-transform: uppercase; letter-spacing: .5px; font-weight: 700; }
.contact-list strong { font-size: 15px; color: #13294d; font-weight: 600; }
.contact-list a { color: var(--brand); }
.contact-list--wide { margin-bottom: 16px; }
.side-map { height: 230px; border-radius: 14px; overflow: hidden; margin-bottom: 8px; }
.big-map { height: 460px; border-radius: 14px; overflow: hidden; margin-bottom: 10px; }
.pick-map { height: 300px; border-radius: 14px; overflow: hidden; margin: 10px 0 14px; }
.boundary-map { position: relative; width: 100%; height: 100%; isolation: isolate; z-index: 0; background: #e8eef2; }
.map-canvas .boundary-map { position: absolute; inset: 0; border-radius: 16px; overflow: hidden; }
.boundary-map--pick .leaflet-container { cursor: crosshair; }
.legend-row { display: flex; flex-wrap: wrap; gap: 14px; font-size: 13px; color: #2b4664; align-items: center; }
.legend-row span { display: inline-flex; align-items: center; gap: 6px; }
.legend-dot { width: 12px; height: 12px; border-radius: 50%; background: #f26a12; border: 2px solid #fff; box-shadow: 0 0 0 1px #f26a12; display: inline-block; }
.back-link { display: inline-flex; align-items: center; gap: 6px; color: var(--brand); font-weight: 700; padding: 6px 2px; text-shadow: 0 0 10px rgba(255,255,255,.95); }
.link-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 4px; }
.link-list a { display: block; padding: 9px 12px; border-radius: 10px; color: #2b4664; font-weight: 600; font-size: 15px; }
.link-list a:hover, .link-list a.active { background: #eef5ff; color: var(--brand); }
.check-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 8px; }
.check-list li { display: flex; gap: 10px; align-items: flex-start; font-size: 15px; color: #1f3550; line-height: 1.5; }
.check-list svg { color: var(--ok); flex: none; margin-top: 2px; }

/* ---------- Bộ máy ---------- */
.org-group { margin: 18px 0 26px; }
.org-group h2 { font-size: 20px; color: #0b2f6b; margin: 0 0 12px; text-shadow: 0 0 12px rgba(255,255,255,.95); }
.person-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 14px; }
.person-card { display: flex; gap: 14px; align-items: center; background: #fff; border-radius: 16px; padding: 16px; box-shadow: 0 10px 24px rgba(20,60,110,.10); border: 1px solid #e6eef7; }
.person-card--flat { box-shadow: none; border: 0; padding: 0; }
.person-card__avatar { width: 54px; height: 54px; flex: none; border-radius: 50%; background: linear-gradient(145deg, #2a6be0, #1747b5); color: #fff; display: grid; place-items: center; font-weight: 800; font-size: 20px; }
.person-card strong { display: block; font-size: 16px; color: #0b2f6b; }
.person-card small { display: block; font-size: 14px; color: var(--muted-2); line-height: 1.45; margin-top: 2px; }
.person-card a { display: inline-flex; gap: 4px; align-items: center; font-size: 13px; color: var(--brand); font-weight: 700; margin-top: 4px; }

/* ---------- KPI ---------- */
.kpi-row, .kpi-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; margin: 4px 0 16px; }
.kpi { background: #fff; border-radius: 16px; padding: 16px 18px; box-shadow: 0 10px 24px rgba(20,60,110,.10); border: 1px solid #e6eef7; }
.kpi strong { display: block; font-size: 26px; font-weight: 800; color: var(--brand); }
.kpi small { font-size: 13px; color: var(--muted-2); font-weight: 600; text-transform: uppercase; letter-spacing: .4px; }

/* ---------- Ấp ---------- */
.hamlet-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 16px; }
.hamlet-card { background: #fff; border-radius: 18px; padding: 18px; box-shadow: 0 10px 24px rgba(20,60,110,.12); border: 1px solid #e6eef7; display: flex; flex-direction: column; gap: 10px; }
.hamlet-card__head { display: flex; gap: 12px; align-items: center; }
.hamlet-card__head > span { width: 46px; height: 46px; border-radius: 14px; background: #eef5ff; color: var(--brand); font-weight: 800; font-size: 20px; display: grid; place-items: center; }
.hamlet-card h3 { margin: 0; font-size: 18px; color: #0b2f6b; }
.hamlet-card small { color: var(--muted-2); }
.hamlet-card p { margin: 0; font-size: 14px; color: #2b4664; display: flex; gap: 6px; align-items: flex-start; line-height: 1.5; }
.mini-stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(90px, 1fr)); gap: 8px; }
.mini-stats div { background: #f6f9fd; border-radius: 12px; padding: 10px; }
.mini-stats strong { display: block; font-size: 15px; color: #0b2f6b; }
.mini-stats small { font-size: 12px; color: var(--muted-2); }
.compass { display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; }
.compass div { background: #f6f9fd; border-radius: 12px; padding: 12px 14px; }
.compass small { display: block; font-size: 12px; font-weight: 800; color: var(--accent); letter-spacing: 1px; }
.compass strong { font-size: 15px; color: #13294d; }
.notice-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 10px; }
.notice-list li { display: flex; gap: 10px; align-items: flex-start; padding: 10px 12px; background: #f6f9fd; border-radius: 12px; }
.notice-list svg { color: var(--accent); flex: none; margin-top: 2px; }
.notice-list strong { display: block; font-size: 15px; color: #13294d; }
.notice-list small { color: var(--muted-2); font-size: 13px; }

/* ---------- Quy hoạch ---------- */
.planning { display: grid; grid-template-columns: 360px minmax(0, 1fr); gap: 18px; align-items: start; }
.planning__form select:disabled { opacity: 1; color: #13294d; font-weight: 600; }
.planning__maphead { display: flex; justify-content: space-between; align-items: center; gap: 10px; margin-bottom: 10px; }
.planning__maphead strong { font-size: 14px; letter-spacing: 1px; color: #0b2f6b; }
.planning .big-map { height: 560px; }
.link-card { margin-top: 22px; }
.link-card ul { list-style: none; padding: 0; margin: 0 0 8px; }
.link-card a { color: var(--brand); font-weight: 700; display: inline-flex; gap: 6px; align-items: center; }
.project-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 16px; }

/* ---------- Du lịch ---------- */
.dest-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 18px; }
.dest-card { background: #fff; border-radius: 18px; overflow: hidden; box-shadow: 0 12px 28px rgba(20,60,110,.14); display: flex; flex-direction: column; }
.dest-card__img { position: relative; height: 210px; overflow: hidden; display: block; }
.dest-card__img img { width: 100%; height: 100%; object-fit: cover; transition: .5s; }
.dest-card:hover img { transform: scale(1.05); }
.dest-card__img span { position: absolute; left: 12px; top: 12px; background: rgba(255,255,255,.92); color: var(--brand); font-size: 12px; font-weight: 800; padding: 5px 10px; border-radius: 999px; }
.dest-card__body { padding: 18px; display: flex; flex-direction: column; gap: 8px; }
.dest-card__body h3 { margin: 0; font-size: 19px; color: #0b2f6b; }
.dest-card__body p { margin: 0; font-size: 14px; color: #3b5571; line-height: 1.55; display: flex; gap: 6px; align-items: flex-start; }
.itin-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 16px; }
.itin h3 { margin: 0 0 6px; color: #0b2f6b; font-size: 18px; }
.itin p { margin: 0 0 12px; color: #3b5571; line-height: 1.6; font-size: 15px; }
.stop-list { margin: 12px 0 0; padding-left: 20px; }
.stop-list a { color: var(--brand); font-weight: 700; }
.detail-cover { border-radius: 18px; overflow: hidden; height: 360px; box-shadow: 0 12px 28px rgba(20,60,110,.16); }
.detail-cover img { width: 100%; height: 100%; object-fit: cover; }

/* ---------- An sinh ---------- */
.quick-cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; margin-bottom: 8px; }
.quick-card { display: flex; gap: 14px; align-items: center; background: #fff; border-radius: 16px; padding: 18px; box-shadow: 0 10px 24px rgba(20,60,110,.12); border: 1px solid #e6eef7; transition: .2s; }
.quick-card:hover { transform: translateY(-3px); }
.quick-card > svg { color: var(--brand); flex: none; }
.quick-card strong { display: block; color: #0b2f6b; font-size: 16px; }
.quick-card small { color: var(--muted-2); font-size: 13px; }
.policy-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(330px, 1fr)); gap: 16px; }
.policy-card { background: #fff; border-radius: 18px; padding: 18px; box-shadow: 0 10px 24px rgba(20,60,110,.12); border: 1px solid #e6eef7; display: flex; flex-direction: column; gap: 8px; }
.policy-card__tags { display: flex; gap: 6px; flex-wrap: wrap; }
.policy-card h3 { margin: 4px 0; font-size: 17px; color: #0b2f6b; line-height: 1.4; }
.policy-card p { margin: 0; font-size: 14px; color: #3b5571; line-height: 1.55; }
.policy-card .btn { margin-top: auto; align-self: flex-start; height: 40px; }

/* ---------- Dịch vụ công ---------- */
.dvc-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; }
.dvc-card { display: flex; gap: 14px; align-items: center; background: #fff; border-radius: 16px; padding: 18px; box-shadow: 0 10px 24px rgba(20,60,110,.12); border: 1px solid #e6eef7; color: #13294d; transition: .2s; }
.dvc-card:hover { transform: translateY(-3px); }
.dvc-card > span { width: 52px; height: 52px; border-radius: 14px; background: #eef5ff; color: var(--brand); display: grid; place-items: center; flex: none; }
.dvc-card div { flex: 1; }
.dvc-card strong { display: block; font-size: 16px; color: #0b2f6b; }
.dvc-card small { color: var(--muted-2); }
.dvc-card > svg:last-child { color: #9db0c3; }
.steps { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(5, 1fr); gap: 12px; }
.steps li { background: #fff; border-radius: 16px; padding: 16px; box-shadow: 0 10px 24px rgba(20,60,110,.10); display: flex; flex-direction: column; gap: 8px; }
.steps li > span { width: 36px; height: 36px; border-radius: 50%; background: var(--accent); color: #fff; font-weight: 800; display: grid; place-items: center; }
.steps strong { color: #0b2f6b; font-size: 16px; }
.steps p { margin: 4px 0 0; font-size: 14px; color: #3b5571; line-height: 1.55; }
.table-card { background: #fff; border-radius: 18px; box-shadow: 0 10px 24px rgba(20,60,110,.12); overflow-x: auto; }
.table { width: 100%; border-collapse: collapse; font-size: 15px; }
.table th { text-align: left; font-size: 13px; text-transform: uppercase; letter-spacing: .5px; color: var(--muted-2); padding: 14px 16px; background: #f6f9fd; }
.table td { padding: 14px 16px; border-top: 1px solid #edf2f8; vertical-align: top; color: #13294d; }
.table td small { display: block; color: var(--muted-2); font-size: 13px; margin-top: 4px; line-height: 1.5; }
.link { color: var(--brand); font-weight: 700; display: inline-flex; gap: 4px; align-items: center; white-space: nowrap; }
.office-card { display: flex; justify-content: space-between; align-items: center; gap: 18px; flex-wrap: wrap; margin-top: 22px; }
.office-card p { margin: 6px 0; display: flex; gap: 8px; align-items: center; color: #2b4664; }

/* ---------- Phản ánh ---------- */
.fb-form { display: flex; flex-direction: column; gap: 18px; }
.dropzone { display: flex; flex-direction: column; align-items: center; gap: 6px; border: 2px dashed #c9d9ec; border-radius: 14px; padding: 22px; background: #fbfdff; color: var(--brand); cursor: pointer; text-align: center; }
.dropzone input { display: none; }
.dropzone strong { font-size: 15px; }
.dropzone small { color: var(--muted-2); }
.thumbs { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 10px; }
.thumb { position: relative; width: 92px; height: 92px; border-radius: 12px; overflow: hidden; box-shadow: 0 4px 12px rgba(20,60,110,.14); }
.thumb img { width: 100%; height: 100%; object-fit: cover; }
.thumb button { position: absolute; top: 4px; right: 4px; width: 24px; height: 24px; border-radius: 50%; border: 0; background: rgba(0,0,0,.6); color: #fff; display: grid; place-items: center; cursor: pointer; }
.success-card { text-align: center; display: flex; flex-direction: column; align-items: center; gap: 8px; padding: 34px; }
.success-card__icon { width: 72px; height: 72px; border-radius: 50%; background: #e7f8ee; color: var(--ok); display: grid; place-items: center; }
.success-card h2 { margin: 6px 0 0; color: #0b2f6b; }
.success-card p { margin: 0; }
.code { font-family: ui-monospace, Menlo, Consolas, monospace; font-weight: 800; color: var(--brand); letter-spacing: .5px; }
.fb-list { display: flex; flex-direction: column; gap: 12px; }
.fb-row { background: #fff; border-radius: 16px; padding: 16px 18px; box-shadow: 0 8px 20px rgba(20,60,110,.10); border: 1px solid #e6eef7; }
.fb-row__head { display: flex; justify-content: space-between; align-items: center; gap: 10px; }
.fb-row h3 { margin: 8px 0 4px; font-size: 17px; color: #0b2f6b; }
.fb-row p { margin: 0 0 8px; color: #3b5571; font-size: 14px; line-height: 1.55; }
.fb-row__meta { display: flex; flex-wrap: wrap; gap: 14px; font-size: 13px; color: var(--muted-2); }
.fb-row__meta span { display: inline-flex; gap: 4px; align-items: center; }
.track .fb-row { margin-top: 8px; }
.timeline { list-style: none; padding: 0; margin: 16px 0 0; display: flex; gap: 0; }
.timeline li { flex: 1; position: relative; padding-top: 26px; font-size: 14px; color: var(--muted-2); }
.timeline li::before { content: ""; position: absolute; top: 4px; left: 0; width: 16px; height: 16px; border-radius: 50%; background: #d6e3f2; }
.timeline li::after { content: ""; position: absolute; top: 11px; left: 18px; right: 4px; height: 2px; background: #d6e3f2; }
.timeline li:last-child::after { display: none; }
.timeline li.done { color: #14532d; }
.timeline li.done::before { background: var(--ok); }
.timeline b { display: block; }

/* ---------- Tin tức ---------- */
.news-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 18px; }
.news-card { background: #fff; border-radius: 18px; overflow: hidden; box-shadow: 0 10px 24px rgba(20,60,110,.12); display: flex; flex-direction: column; transition: .2s; color: #13294d; }
.news-card:hover { transform: translateY(-4px); }
.news-card > img, .news-card__img { height: 190px; position: relative; overflow: hidden; display: block; }
.news-card img { width: 100%; height: 100%; object-fit: cover; }
.news-card__img span { position: absolute; left: 12px; top: 12px; background: var(--accent); color: #fff; font-size: 11px; font-weight: 800; padding: 5px 10px; border-radius: 8px; }
.news-card__img .sample { position: absolute; right: 12px; top: 12px; background: rgba(255,255,255,.92); color: #7a4a06; font-style: normal; font-size: 11px; font-weight: 800; padding: 5px 10px; border-radius: 8px; }
.news-card > div:last-child { padding: 16px 18px 20px; display: flex; flex-direction: column; gap: 6px; }
.news-card small { color: var(--muted-2); display: inline-flex; gap: 4px; align-items: center; font-size: 13px; }
.news-card h3 { margin: 0; font-size: 17px; line-height: 1.45; color: #0b2f6b; }
.news-card p { margin: 0; font-size: 14px; color: #3b5571; line-height: 1.55; }
.related { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 12px; }
.related a { display: flex; gap: 10px; align-items: center; }
.related img { width: 72px; height: 56px; object-fit: cover; border-radius: 10px; flex: none; }
.related strong { display: block; font-size: 14px; color: #13294d; line-height: 1.4; }
.related small { color: var(--muted-2); font-size: 12px; }

/* ---------- Tìm kiếm, liên hệ, FAQ ---------- */
.search-list { display: flex; flex-direction: column; gap: 10px; }
.search-hit { display: flex; gap: 14px; align-items: center; background: #fff; border-radius: 14px; padding: 14px 16px; box-shadow: 0 6px 16px rgba(20,60,110,.08); color: #13294d; }
.search-hit div { flex: 1; min-width: 0; }
.search-hit strong { display: block; color: #0b2f6b; }
.search-hit p { margin: 2px 0 0; font-size: 14px; color: var(--muted-2); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.channel-list { display: flex; flex-direction: column; gap: 10px; }
.channel { display: flex; gap: 12px; align-items: center; padding: 12px; border-radius: 14px; background: #f6f9fd; color: #13294d; }
.channel > span { width: 42px; height: 42px; border-radius: 12px; background: #fff; color: var(--brand); display: grid; place-items: center; flex: none; }
.channel div { flex: 1; }
.channel strong { display: block; font-size: 15px; }
.channel small { color: var(--muted-2); }
.faq details { border-bottom: 1px solid #e6eef7; padding: 14px 4px; }
.faq summary { cursor: pointer; font-weight: 700; color: #0b2f6b; font-size: 16px; }
.faq p { margin: 10px 0 0; }

/* ---------- Responsive ---------- */
@media (max-width: 1180px) {
  .subnav__links a { padding: 7px 9px; font-size: 13px; }
  .page-grid { grid-template-columns: minmax(0, 1fr) 300px; }
  .steps { grid-template-columns: repeat(3, 1fr); }
  .planning { grid-template-columns: 320px minmax(0, 1fr); }
}
@media (max-width: 920px) {
  .subnav__toggle { display: grid; }
  .subnav__links { display: none; position: absolute; top: calc(100% + 8px); left: 0; right: 0; background: #fff; border-radius: 16px; padding: 10px; box-shadow: 0 16px 34px rgba(20,60,110,.18); flex-direction: column; }
  .subnav__links--open { display: flex; }
  .subnav .container { position: relative; }
  .page-grid, .planning { grid-template-columns: 1fr; }
  .quick-cards, .dvc-grid { grid-template-columns: 1fr; }
  .kpi-row, .kpi-grid { grid-template-columns: repeat(2, 1fr); }
  .fact-grid { grid-template-columns: repeat(2, 1fr); }
  .planning .big-map { height: 420px; }
}
@media (max-width: 600px) {
  .page-hero { padding: 24px 0 18px; }
  .page-hero p { font-size: 15px; }
  .field-row { flex-direction: column; gap: 0; }
  .field-grid, .fact-grid, .compass { grid-template-columns: 1fr; }
  .steps { grid-template-columns: 1fr; }
  .big-map { height: 340px; }
  .detail-cover { height: 230px; }
  .inline-search { min-width: 0; width: 100%; }
  .block__title { font-size: 22px; }
  .card { padding: 18px; }
  .table th:nth-child(4), .table td:nth-child(4) { display: none; }
}
@media print {
  .topbar-wrap, .subnav, .support-strip, .footer, .chatbot, .page-bg, .page-side, .meta-row button { display: none !important; }
  .page-grid { grid-template-columns: 1fr; }
}
